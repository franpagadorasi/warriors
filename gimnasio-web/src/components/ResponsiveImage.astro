---
interface Props {
	src: string;
	alt: string;
	mobileSrc?: string;
	class?: string;
	imgClass?: string;
	stretch?: boolean;
	loading?: 'eager' | 'lazy';
	decoding?: 'sync' | 'async' | 'auto';
	fetchpriority?: 'high' | 'low' | 'auto';
	sizes?: string;
	width?: number;
	height?: number;
}

const {
	src,
	alt,
	mobileSrc,
	class: className,
	imgClass,
	stretch = true,
	loading = 'lazy',
	decoding = 'async',
	fetchpriority,
	sizes,
	width,
	height
} = Astro.props;
---

<picture class={className} style={stretch ? 'display:block;width:100%;height:100%;' : undefined}>
	{mobileSrc && <source media="(max-width: 760px)" srcset={mobileSrc} />}
	<img
		class={imgClass}
		src={src}
		alt={alt}
		loading={loading}
		decoding={decoding}
		fetchpriority={fetchpriority}
		sizes={sizes}
		width={width}
		height={height}
	/>
</picture>
