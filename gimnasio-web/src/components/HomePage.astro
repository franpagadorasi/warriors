---
import Layout from '../layouts/Layout.astro';
import { getSiteCopy, type Locale } from '../lib/site-copy';

interface Props {
	locale?: Locale;
}

const { locale = 'ca' } = Astro.props;
const copy = getSiteCopy(locale);

const formatNewsDate = (date: string) => {
	const parsed = new Date(date);
	if (Number.isNaN(parsed.getTime())) return date;
	const monthMap: Record<Locale, string[]> = {
		ca: ['GEN', 'FEB', 'MAR', 'ABR', 'MAI', 'JUN', 'JUL', 'AGO', 'SET', 'OCT', 'NOV', 'DES'],
		es: ['ENE', 'FEB', 'MAR', 'ABR', 'MAY', 'JUN', 'JUL', 'AGO', 'SEP', 'OCT', 'NOV', 'DIC'],
		en: ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC']
	};
	const months = monthMap[locale];
	return `${String(parsed.getUTCDate()).padStart(2, '0')} ${months[parsed.getUTCMonth()]} ${parsed.getUTCFullYear()}`;
};

const galleryItems = [...copy.gallery.items].sort((a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured)));
const clubAddress = copy.footer.address;
const mapEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(clubAddress)}&output=embed`;
const mapDirectionsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(clubAddress)}`;

const pricingPlans = copy.pricing.plans;
const clubReasons = copy.pricing.reasons;
const weeklySchedule = copy.schedule.rows;
const ageGroups = copy.schedule.ages;
const valuePillars = copy.schedule.values;
const localePaths: Record<Locale, string> = { ca: '/', es: '/es/', en: '/en/' };
const localeLabels: Record<Locale, string> = { ca: 'Català', es: 'Español', en: 'English' };
const languageAria: Record<Locale, string> = {
	ca: 'Idiomes disponibles',
	es: 'Idiomas disponibles',
	en: 'Available languages'
};
const closeModalLabel: Record<Locale, string> = {
	ca: 'Tancar',
	es: 'Cerrar',
	en: 'Close'
};
---

<Layout title={copy.seoTitle} description={copy.seoDescription} lang={copy.lang}>
	<header class="site-header">
		<div class="container header-row">
			<a class="brand" href="#inicio">
				<img src="/images/logo-warriors-horizontal.png" alt="Club Taekwondo Warriors" class="brand-logo-full" />
			</a>

			<button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" data-menu-toggle>
				<span></span>
				<span></span>
				<span></span>
			</button>

			<nav class="nav" data-mobile-nav>
				<a class="active" href="#inicio">{copy.nav.home}</a>
				<a href="#club">{copy.nav.about}</a>
				<a href="#clases">{copy.nav.classes}</a>
				<a href="#cuotas">{copy.nav.pricing}</a>
				<a href="#horarios">{copy.nav.schedule}</a>
				<a href="#galeria-destacada">{copy.nav.gallery}</a>
				<a href="#contacto">{copy.nav.contact}</a>
			</nav>

			<div class="header-languages" aria-label={languageAria[locale]}>
				<a class={`language-flag ${locale === 'ca' ? 'active' : ''}`} href={localePaths.ca} aria-label="Català" title="Català"></a>
				<a class={`language-flag ${locale === 'es' ? 'active' : ''}`} href={localePaths.es} aria-label="Español" title="Español"></a>
				<a class={`language-flag ${locale === 'en' ? 'active' : ''}`} href={localePaths.en} aria-label="English" title="English"></a>
			</div>

			<div class="header-language-select">
				<label class="sr-only" for="mobile-language-select">{languageAria[locale]}</label>
				<select
					id="mobile-language-select"
					class="language-select"
					aria-label={languageAria[locale]}
					onchange="window.location.href=this.value"
				>
					<option value={localePaths.ca} selected={locale === 'ca'}>Català</option>
					<option value={localePaths.es} selected={locale === 'es'}>Español</option>
					<option value={localePaths.en} selected={locale === 'en'}>English</option>
				</select>
			</div>

			<div class="mobile-language-menu" data-language-menu>
				<button
					class={`mobile-language-trigger flag-${locale}`}
					type="button"
					aria-label={languageAria[locale]}
					aria-expanded="false"
					data-language-toggle
				>
					<span class="mobile-language-flag" aria-hidden="true"></span>
					<span class="mobile-language-caret" aria-hidden="true"></span>
				</button>
				<div class="mobile-language-options" data-language-options>
					<a class={`mobile-language-option flag-ca ${locale === 'ca' ? 'active' : ''}`} href={localePaths.ca} aria-label={localeLabels.ca} title={localeLabels.ca}>
						<span class="mobile-language-flag" aria-hidden="true"></span>
					</a>
					<a class={`mobile-language-option flag-es ${locale === 'es' ? 'active' : ''}`} href={localePaths.es} aria-label={localeLabels.es} title={localeLabels.es}>
						<span class="mobile-language-flag" aria-hidden="true"></span>
					</a>
					<a class={`mobile-language-option flag-en ${locale === 'en' ? 'active' : ''}`} href={localePaths.en} aria-label={localeLabels.en} title={localeLabels.en}>
						<span class="mobile-language-flag" aria-hidden="true"></span>
					</a>
				</div>
			</div>
		</div>
	</header>

	<main>
		<section class="hero" id="inicio">
			<div class="container hero-shell">
				<div class="hero-copy">
					<p class="hero-kicker">{copy.hero.eyebrow}</p>
					<h1 class="hero-title">
						<span class="hero-title-main">{copy.hero.titleMain}</span>
						<span class="hero-title-accent">{copy.hero.titleAccent}</span>
					</h1>
					<p class="hero-values">{copy.hero.values}</p>
					<p class="hero-chant">{copy.hero.chant}</p>
					<p class="hero-text">{copy.hero.description}</p>

					<div class="hero-actions">
						<a class="button button-primary" href="#contacto">{copy.hero.primaryCta}</a>
						<a class="button button-secondary" href="#club">{copy.hero.secondaryCta}</a>
					</div>
				</div>

				<div class="hero-media">
					<div class="hero-ring" aria-hidden="true"></div>
					<img src="/images/hero-taekwondo.png" alt={copy.hero.imageAlt} />
					<div class="hero-side-copy">
						{copy.hero.sideWords.map((word) => <p>{word}</p>)}
					</div>
				</div>
			</div>

			<div class="container feature-band">
				{copy.features.map((item) => (
					<article class={`feature-card ${item.tone ?? 'red'}`}>
						<div class="feature-icon"></div>
						<div>
							<h2>{item.title}</h2>
							<p>{item.description}</p>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="about-section" id="club">
			<div class="container">
				<div class="section-title-line about-title-line">
					<span></span>
					<h2 class="section-title center-title unified-title">{copy.about.kicker}</h2>
					<span></span>
				</div>
			</div>
			<div class="container about-shell">
				<div class="about-copy">
					<h3 class="about-lead">{copy.about.title}</h3>
					<p class="section-copy">{copy.about.description}</p>
					<a class="button button-blue" href="#contacto">{copy.about.cta}</a>
				</div>

				<div class="about-gallery" id="galeria">
					<img class="about-main" src="/images/dojo-interior.png" alt={copy.about.imagesAlt[0]} />
					<img src="/images/kids-taekwondo.png" alt={copy.about.imagesAlt[1]} />
					<img src="/images/modalidad-exhibicion.png" alt={copy.about.imagesAlt[2]} />
					<img src="/images/modalidad-combate.png" alt={copy.about.imagesAlt[3]} />
				</div>
			</div>
		</section>

		<section class="classes-section" id="clases">
			<div class="container">
				<div class="section-title-line">
					<span></span>
					<h2 class="section-title center-title unified-title">{copy.classes.title}</h2>
					<span></span>
				</div>

				<div class="class-grid">
					{copy.classes.items.map((item) => (
						<article class="class-card">
							<div class="class-thumb">
								<img src={item.imageUrl} alt={item.title} />
							</div>

							<div class="class-copy">
								<h3>{item.title}</h3>
								<p>{item.description}</p>

								<div class="class-meta">
									<span>{item.audience}</span>
									<a href="#contacto">{copy.classes.moreInfo}</a>
								</div>
							</div>
						</article>
					))}
				</div>

				<div class="section-actions">
					<a class="button button-outline-dark" href="#contacto">{copy.classes.button}</a>
				</div>
			</div>
		</section>

		<section class="pricing-section" id="cuotas">
			<div class="container">
				<div class="pricing-header">
					<div class="pricing-heading-line">
						<span></span>
						<p>{copy.pricing.title}</p>
						<span></span>
					</div>
				</div>

				<div class="pricing-grid">
					{pricingPlans.map((plan) => (
						<article class={`pricing-card ${plan.tone}`}>
							{plan.badge && <span class="pricing-badge">{plan.badge}</span>}
							<div class="pricing-belt" aria-hidden="true">
								<img src={`/images/belt-${plan.tone}-poster.png`} alt="" loading="lazy" />
							</div>

							<div class="pricing-head">
								<p class="pricing-plan-label">{copy.pricing.cardLabel}</p>
								<h3>{plan.name.replace(/^(Quota|Cuota|Plan)\s/i, '')}</h3>
								<p>{plan.subtitle}</p>
							</div>

							<div class="pricing-divider" aria-hidden="true">
								<span></span>
								<div class="pricing-star"></div>
								<span></span>
							</div>

							<ul class="pricing-list">
								{plan.items.map((item) => (
									<li>
										<span class={`feature-icon-svg ${plan.tone}`}>
											{
												item.icon === 'calendar' && (
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<rect x="3" y="5" width="18" height="16" rx="2"></rect>
														<path d="M8 3v4M16 3v4M3 10h18"></path>
													</svg>
												)
											}
											{
												item.icon === 'user' && (
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<circle cx="12" cy="8" r="4"></circle>
														<path d="M5 20c1.8-3.5 4.2-5 7-5s5.2 1.5 7 5"></path>
													</svg>
												)
											}
											{
												item.icon === 'target' && (
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<circle cx="12" cy="12" r="8"></circle>
														<circle cx="12" cy="12" r="4"></circle>
														<circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"></circle>
													</svg>
												)
											}
											{
												item.icon === 'shield' && (
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<path d="M12 3l7 3v5c0 4.7-2.4 7.8-7 10-4.6-2.2-7-5.3-7-10V6l7-3z"></path>
														<path d="M9.5 12.5l1.7 1.7 3.5-4"></path>
													</svg>
												)
											}
											{
												item.icon === 'growth' && (
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<path d="M4 19V10M10 19V6M16 19v-8M4 19h16"></path>
														<path d="M13 8l4-4 3 3"></path>
													</svg>
												)
											}
											{
												item.icon === 'cap' && (
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<path d="M3 9l9-4 9 4-9 4-9-4z"></path>
														<path d="M7 11v4c2.4 1.8 7.6 1.8 10 0v-4"></path>
														<path d="M21 9v6"></path>
													</svg>
												)
											}
											{
												item.icon === 'arm' && (
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<path d="M8 13c1-2 1.3-4.8 3-5.5 1.5-.6 2.3 1.1 2.2 2.5 1.3-.5 2.9 0 3.5 1.3.7 1.4-.1 3.1-1.1 4.2-1.8 2.1-4 3.5-7.6 3.5-2.7 0-4.5-1.2-4.5-3.4 0-1.4 1.1-2.6 2.7-2.6H8z"></path>
														<path d="M9.5 7.5l1.5 1.8"></path>
													</svg>
												)
											}
											{
												item.icon === 'trophy' && (
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<path d="M8 4h8v4a4 4 0 0 1-8 0V4z"></path>
														<path d="M9 14h6M10 14v4M14 14v4M8 20h8"></path>
														<path d="M8 6H5a3 3 0 0 0 3 4M16 6h3a3 3 0 0 1-3 4"></path>
													</svg>
												)
											}
											{
												item.icon === 'kick' && (
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<circle cx="8.5" cy="5.5" r="2"></circle>
														<path d="M10 8l2.5 2.5 3.5 1M12.5 10.5l-2 4-3 2.5M10.5 12l4 4M7.5 17l1.5 3M15.5 11.5l4.5-1.5"></path>
													</svg>
												)
											}
											{
												item.icon === 'barbell' && (
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<path d="M3 10v4M6 8v8M9 9v6M15 9v6M18 8v8M21 10v4M9 12h6"></path>
													</svg>
												)
											}
										</span>
										<span>{item.text}</span>
									</li>
								))}
							</ul>

							<div class="pricing-price">
								<div class="pricing-brush" aria-hidden="true"></div>
								<strong>{plan.price}<span class="pricing-currency">&euro;</span></strong>
								<span>{plan.frequency}</span>
							</div>
						</article>
					))}
				</div>

				<div class="reasons-row">
					<p class="reasons-title">{copy.pricing.reasonsTitle}</p>
					<div class="reasons-grid">
						{clubReasons.map((reason) => (
							<article class="reason-item">
								<span class="reason-icon">
									{
										reason.icon === 'rings' && (
											<svg viewBox="0 0 90 36" aria-hidden="true">
												<circle cx="15" cy="14" r="11"></circle>
												<circle cx="37" cy="14" r="11"></circle>
												<circle cx="59" cy="14" r="11"></circle>
												<circle cx="26" cy="23" r="11"></circle>
												<circle cx="48" cy="23" r="11"></circle>
											</svg>
										)
									}
									{
										reason.icon === 'teacher' && (
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<circle cx="12" cy="6.5" r="3.2"></circle>
												<path d="M7 20v-3.2c0-2.5 2-4.5 5-4.5s5 2 5 4.5V20"></path>
												<path d="M6 10l6 3 6-3"></path>
											</svg>
										)
									}
									{
										reason.icon === 'belt' && (
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<path d="M3 11h18"></path>
												<path d="M9 9l3 3-3 3-4-3 4-3z"></path>
												<path d="M15 9l4 3-4 3-3-3 3-3z"></path>
											</svg>
										)
									}
									{
										reason.icon === 'kick' && (
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<circle cx="8.5" cy="5.5" r="2"></circle>
												<path d="M10 8l2.5 2.5 3.5 1M12.5 10.5l-2 4-3 2.5M10.5 12l4 4M7.5 17l1.5 3M15.5 11.5l4.5-1.5"></path>
											</svg>
										)
									}
									{
										reason.icon === 'podium' && (
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<path d="M4 20V12h4v8M10 20V8h4v12M16 20v-5h4v5"></path>
												<path d="M12 4l1 2 2 .2-1.6 1.4.5 2.1L12 8.6 10.1 9.7l.5-2.1L9 6.2 11 6l1-2z"></path>
											</svg>
										)
									}
									{
										reason.icon === 'group' && (
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<circle cx="12" cy="7" r="3"></circle>
												<circle cx="6.5" cy="9" r="2.5"></circle>
												<circle cx="17.5" cy="9" r="2.5"></circle>
												<path d="M5 20c.6-2.5 2.3-4 4.8-4h4.4c2.5 0 4.2 1.5 4.8 4"></path>
											</svg>
										)
									}
								</span>
								<span>{reason.text}</span>
							</article>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="schedule-showcase" id="horarios">
			<div class="container">
				<div class="section-title-line">
					<span></span>
					<h2 class="section-title center-title unified-title">{copy.schedule.title}</h2>
					<span></span>
				</div>

				<div class="schedule-board-wrap">
					<div class="schedule-board">
					<div class="schedule-header">{copy.schedule.headerTime}</div>
					{copy.schedule.days.map((day) => <div class="schedule-header">{day}</div>)}

						{weeklySchedule.map((row) => (
						<>
							<div class={`schedule-time ${row.tone}`}>
								<span class="schedule-time-icon" aria-hidden="true"></span>
								<strong>{row.time}</strong>
							</div>
							{row.classes.map((item) => (
								<div class={`schedule-cell ${row.tone} ${!item ? 'empty' : ''}`}>
									{
										item && (
											<span>
												<small>Warriors</small>
												<strong>{item.replace('Warriors ', '')}</strong>
											</span>
										)
									}
								</div>
							))}
						</>
						))}
					</div>
				</div>

				<div class="schedule-notes">
					<div class="age-box">
						{ageGroups.map((group) => (
							<div class={`age-line ${group.tone}`}>
								<div class="age-swatch" aria-hidden="true"></div>
								<div class="age-copy">
									<strong>{group.label}</strong>
									<span>{group.range}</span>
								</div>
							</div>
						))}
					</div>

					<div class="values-box">
						{valuePillars.map((item) => (
							<div class={`value-pill ${item.tone}`}>
								<span class="value-pill-icon" aria-hidden="true">
									{
										item.icon === 'handshake' && (
											<svg viewBox="0 0 24 24">
												<path d="M7 12l2-2 2 2 2-2 4 4"></path>
												<path d="M3 11l3-3 3 3-3 3-3-3z"></path>
												<path d="M15 14l3-3 3 3-3 3-3-3z"></path>
											</svg>
										)
									}
									{
										item.icon === 'flag' && (
											<svg viewBox="0 0 24 24">
												<path d="M6 3v18"></path>
												<path d="M7 4h10l-2.5 4 2.5 4H7z"></path>
											</svg>
										)
									}
									{
										item.icon === 'lotus' && (
											<svg viewBox="0 0 24 24">
												<path d="M12 7c1.8 1.3 2.9 3.1 2.9 5.2 0 1.7-.7 3.1-2.1 4.3"></path>
												<path d="M12 7c-1.8 1.3-2.9 3.1-2.9 5.2 0 1.7.7 3.1 2.1 4.3"></path>
												<path d="M12 7c3.2 1 5.2 3.3 5.2 6 0 2.3-1.6 3.9-5.2 4.8"></path>
												<path d="M12 7c-3.2 1-5.2 3.3-5.2 6 0 2.3 1.6 3.9 5.2 4.8"></path>
											</svg>
										)
									}
									{
										item.icon === 'dobok' && (
											<svg viewBox="0 0 24 24">
												<path d="M9 4h6l2 4-2 2v10h-2v-7h-2v7H9V10L7 8l2-4z"></path>
												<path d="M10 4l2 4 2-4"></path>
											</svg>
										)
									}
								</span>
								<span class="value-pill-text">{item.label}</span>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="stats-band">
			<div class="container stats-grid">
				{copy.stats.map((item) => (
					<div class={`stat-card ${item.tone ?? 'red'}`}>
						<strong>{item.value}</strong>
						<span>{item.label}</span>
					</div>
				))}
			</div>
		</section>

		<section class="updates-section">
			<div class="container updates-grid">
				<div class="gallery-panel" id="galeria-destacada">
					<div class="section-head gallery-head">
						<div class="section-title-line">
							<span></span>
							<h2 class="unified-title">{copy.gallery.title}</h2>
							<span></span>
						</div>
					</div>

					<div class="gallery-grid">
						{galleryItems.map((item, index) => (
							<div class={`gallery-card gallery-${index + 1}`}>
								<img src={item.imageUrl || '/images/dojo-interior.png'} alt={item.title} />
							</div>
						))}
					</div>

					<div class="gallery-link-row">
						<a href="#contacto">{copy.gallery.linkLabel}</a>
					</div>
				</div>
			</div>
		</section>

		<section class="cta-banner">
			<div class="container cta-shell">
				<div class="cta-image">
					<img src={copy.cta.imageUrl} alt={copy.cta.imageAlt} />
				</div>

				<div class="cta-copy">
					<h2>{copy.cta.title}</h2>
					<p>{copy.cta.description}</p>
				</div>

