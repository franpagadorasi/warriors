		.mobile-language-flag {
			width: 1.38rem;
			height: 1.38rem;
		}

		.feature-band,
		.class-grid,
		.pricing-grid,
		.stats-grid,
		.conversion-panel-actions,
		.cta-actions {
			grid-template-columns: 1fr;
		}

		.reasons-grid {
			grid-template-columns: 1fr 1fr;
			gap: 0.7rem;
