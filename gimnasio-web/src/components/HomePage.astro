	<script is:inline>
		(() => {
			const initMobileMenu = () => {
				const header = document.querySelector('.site-header');
				const toggle = document.querySelector('[data-menu-toggle]');
				const nav = document.querySelector('[data-mobile-nav]');

				if (!(header instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;

				const closeMenu = () => {
					header.classList.remove('menu-open');
					header.classList.remove('language-open');
					toggle.setAttribute('aria-expanded', 'false');
					document.body.style.overflow = '';
				};

				const openMenu = () => {
					header.classList.add('menu-open');
					toggle.setAttribute('aria-expanded', 'true');
					document.body.style.overflow = 'hidden';
				};

				toggle.addEventListener('click', () => {
					if (header.classList.contains('menu-open')) {
						closeMenu();
					} else {
						openMenu();
					}
				});

				nav.querySelectorAll('a').forEach((link) => {
					link.addEventListener('click', closeMenu);
				});

				window.addEventListener('resize', () => {
					if (window.innerWidth > 760) {
						closeMenu();
					}
				});

				const languageToggle = document.querySelector('[data-language-toggle]');
				const languageOptions = document.querySelector('[data-language-options]');

				if (languageToggle instanceof HTMLButtonElement && languageOptions instanceof HTMLElement) {
					const closeLanguageMenu = () => {
						header.classList.remove('language-open');
						languageToggle.setAttribute('aria-expanded', 'false');
					};

					const openLanguageMenu = () => {
						header.classList.add('language-open');
						languageToggle.setAttribute('aria-expanded', 'true');
					};

					languageToggle.addEventListener('click', (event) => {
						event.stopPropagation();
						if (header.classList.contains('language-open')) {
							closeLanguageMenu();
						} else {
							openLanguageMenu();
						}
					});

					languageOptions.querySelectorAll('a').forEach((link) => {
						link.addEventListener('click', closeLanguageMenu);
					});

					document.addEventListener('click', (event) => {
						const target = event.target;
						if (!(target instanceof Node)) return;
						if (!languageOptions.contains(target) && !languageToggle.contains(target)) {
							closeLanguageMenu();
						}
					});
				}
			};

			const initReservaModal = () => {
				const overlay = document.querySelector('[data-reserva-overlay]');
				const openButtons = document.querySelectorAll('[data-open-reserva-modal]');
				const closeButtons = document.querySelectorAll('[data-close-reserva-modal]');

				if (!(overlay instanceof HTMLElement) || openButtons.length === 0) return;

				const openModal = () => {
					overlay.hidden = false;
					document.body.style.overflow = 'hidden';
				};

				const closeModal = () => {
					overlay.hidden = true;
					document.body.style.overflow = '';
				};

				window.__openReservaModal = openModal;
				window.__closeReservaModal = closeModal;

				openButtons.forEach((button) => {
					button.addEventListener('click', openModal);
				});

				closeButtons.forEach((button) => {
					button.addEventListener('click', closeModal);
				});

				document.addEventListener('keydown', (event) => {
					if (event.key === 'Escape' && !overlay.hidden) {
						closeModal();
					}
				});
			};

			if (document.readyState === 'loading') {
				document.addEventListener(
					'DOMContentLoaded',
					() => {
						initMobileMenu();
						initReservaModal();
					},
					{ once: true }
				);
			} else {
				initMobileMenu();
				initReservaModal();
			}
		})();
	</script>
