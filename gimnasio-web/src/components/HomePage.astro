		padding-top: 1.5rem;
	}

	.reasons-title {
		margin: 0 0 1.2rem;
		text-align: center;
		font-size: clamp(1.45rem, 3vw, 2.2rem);
		font-weight: 900;
		font-style: italic;
		text-transform: uppercase;
		color: #10245f;
