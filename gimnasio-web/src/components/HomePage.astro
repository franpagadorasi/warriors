	.reviews-rating-copy strong {
		font-size: 1.15rem;
		line-height: 1.1;
		color: #ffffff;
	}

	.reviews-rating-copy span {
		font-size: 0.9rem;
		color: #d1d7e5;
	}

	.reviews-stars {
		display: flex;
		gap: 0.2rem;
		font-size: 1.12rem;
		line-height: 1;
		color: #f6c21c;
	}

	.reviews-button {
		margin-top: auto;
		box-shadow: 0 10px 22px rgba(227, 29, 28, 0.24);
		transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
