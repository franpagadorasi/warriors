			left: 0;
			right: 0;
			display: none;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 0.55rem;
			font-size: 0.98rem;
			line-height: 1.15;
			border-radius: 1rem;
			background: rgba(10, 12, 18, 0.98);
			border: 1px solid rgba(255, 255, 255, 0.08);
			box-shadow: 0 20px 40px rgba(0, 0, 0, 0.32);
			z-index: 30;
