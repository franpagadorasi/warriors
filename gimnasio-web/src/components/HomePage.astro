		font-size: 0.95rem;
		font-weight: 900;
		line-height: 1.2;
		text-transform: uppercase;
		color: #10245f;
		border-left: 1px solid rgba(227, 173, 18, 0.5);
	}

	.reason-item:first-child {
		border-left: 0;
	}

	.reason-icon {
		width: 5.4rem;
		height: 4rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: #10245f;
	}

	.reason-icon svg {
		width: 100%;
		height: 100%;
		stroke: currentColor;
		fill: none;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.class-thumb {
		height: 11rem;
		overflow: hidden;
		background: #101522;
	}

	.class-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.class-copy {
		padding: 1.15rem 1rem 1rem;
	}

	.class-copy h3 {
		margin: 0 0 0.55rem;
		font-size: 1.05rem;
		text-transform: uppercase;
	}

	.class-copy p {
		margin: 0;
		color: #4d5669;
		line-height: 1.55;
		min-height: 5.8rem;
	}

	.class-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.8rem;
		padding-top: 0.9rem;
		margin-top: 1rem;
		border-top: 1px solid rgba(17, 23, 35, 0.08);
	}

	.class-meta span,
	.class-meta a {
		font-size: 0.84rem;
		font-weight: 900;
		text-transform: uppercase;
	}

	.class-meta span {
		color: #1d5fff;
	}

	.class-meta a {
		color: #ea211c;
	}

	.section-actions {
		display: flex;
		justify-content: center;
		margin-top: 2rem;
	}

	.stats-band {
		background: #101113;
	}

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
	}

	.stat-card {
		padding: 1.5rem 1rem;
		text-align: center;
		border-right: 1px solid rgba(255, 255, 255, 0.08);
	}

	.stat-card:last-child {
		border-right: 0;
	}

	.stat-card strong {
		display: block;
		font-size: 2.5rem;
		line-height: 1;
	}

	.stat-card span {
		display: block;
		margin-top: 0.35rem;
		font-size: 0.82rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #d8dbe3;
	}

	.stat-card.red strong {
		color: #ff342a;
	}

	.stat-card.blue strong {
		color: #2e6bff;
	}

	.updates-section {
		padding: 1.5rem 0 2.8rem;
		background: #f5f5f5;
		color: #111827;
	}

	.updates-section .container,
	.cta-banner .container {
		width: min(var(--max-width), calc(100% - 1rem));
	}

	.updates-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.1rem;
		align-items: start;
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.85rem;
	}

	.section-head h2 {
		margin: 0;
	}

	.section-head a {
		font-size: 0.82rem;
		font-weight: 900;
		text-transform: uppercase;
		color: #1c57e8;
	}

	.section-head .section-title-line {
		flex: 1 1 auto;
		margin: 0 auto;
	}

	.gallery-head {
		justify-content: center;
	}

	.gallery-head .section-title-line {
		width: 100%;
	}

	.gallery-link-row {
		display: flex;
		justify-content: flex-end;
		margin-top: 0.9rem;
	}

	.gallery-link-row a {
		font-size: 0.82rem;
		font-weight: 900;
		text-transform: uppercase;
		color: #1c57e8;
	}

	.gallery-card {
		background: #fff;
		box-shadow: 0 14px 30px rgba(15, 18, 28, 0.08);
		overflow: hidden;
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		grid-template-rows: 10rem 10rem;
		gap: 0.7rem;
	}

	.gallery-1 {
		grid-row: span 2;
	}

	.gallery-card {
		border: 1px solid rgba(17, 23, 35, 0.08);
	}

	.gallery-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.cta-banner {
		padding: 0 0 2.8rem;
		background: #f5f5f5;
	}

	.cta-shell {
		display: grid;
		grid-template-columns: 1fr 1.3fr auto;
		align-items: center;
		gap: 0;
		padding: 0;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.04), transparent 35%),
			linear-gradient(180deg, #101114 0%, #17181c 100%);
		overflow: hidden;
		border-radius: 0;
		border: 0;
		box-shadow: 0 22px 40px rgba(15, 18, 28, 0.14);
		position: relative;
		min-height: 23rem;
	}

	.cta-shell::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(255, 255, 255, 0.03), transparent 22%, transparent 78%, rgba(255, 255, 255, 0.03)),
			radial-gradient(circle at 78% 40%, rgba(227, 29, 28, 0.14), transparent 18%);
		pointer-events: none;
	}

	.cta-image {
		min-height: 23rem;
		height: 100%;
		position: relative;
	}

	.cta-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.cta-image::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(0, 0, 0, 0.12), transparent 22%, transparent 72%, rgba(0, 0, 0, 0.38)),
			linear-gradient(180deg, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.12));
	}

	.cta-copy {
		padding: 2.2rem 2.4rem 2.2rem 2rem;
		position: relative;
		z-index: 1;
		align-self: stretch;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.cta-copy h2 {
		margin: 0;
		max-width: 11ch;
		font-size: clamp(3.2rem, 5.2vw, 5.6rem);
		text-transform: uppercase;
		line-height: 0.9;
		letter-spacing: 0.015em;
	}

	.cta-copy p {
		margin: 0.8rem 0 0;
		color: #d7ddeb;
		max-width: 30ch;
		font-size: 1.2rem;
		line-height: 1.3;
	}

	.cta-button {
		margin: auto 2.2rem 2rem auto;
		padding: 1rem 1.65rem;
		min-width: 12.5rem;
		border-radius: 1rem;
		font-size: 1.1rem;
		box-shadow: 0 12px 26px rgba(227, 29, 28, 0.28);
		position: relative;
		z-index: 1;
		align-self: end;
		border: 0;
		cursor: pointer;
		appearance: none;
	}

	.reserva-overlay {
		position: fixed;
		inset: 0;
		display: grid;
		place-items: center;
		padding: 1rem;
		z-index: 120;
	}

	.reserva-overlay[hidden] {
		display: none;
	}

	.modal-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(6, 8, 14, 0.72);
		backdrop-filter: blur(6px);
	}

	.reserva-modal {
		position: relative;
		z-index: 1;
		width: min(34rem, 100%);
		background: linear-gradient(180deg, #101114 0%, #181a1f 100%);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 1.4rem;
		box-shadow: 0 28px 56px rgba(0, 0, 0, 0.35);
		padding: 1.6rem;
		color: #ffffff;
	}

	.reserva-modal-kicker {
		margin: 0 0 0.4rem;
		color: #ffd24a;
		font-size: 0.95rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.reserva-modal h2 {
		margin: 0;
		font-size: clamp(2.1rem, 4vw, 3.1rem);
		line-height: 0.95;
		text-transform: uppercase;
	}

	.reserva-modal-copy {
		margin: 0.8rem 0 1.2rem;
		font-size: 1rem;
		line-height: 1.45;
		color: #d7ddeb;
	}

	.reserva-modal-close {
		position: absolute;
		top: 0.8rem;
		right: 0.8rem;
		width: 2.4rem;
		height: 2.4rem;
		border: 0;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.08);
		color: #ffffff;
		font-size: 1.5rem;
		cursor: pointer;
	}

	.reserva-options {
		display: grid;
		gap: 0.8rem;
	}

	.reserva-option {
		display: flex;
		flex-direction: column;
		gap: 0.18rem;
		padding: 1rem 1.05rem;
		border-radius: 1rem;
		color: #ffffff;
		border: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
		transition: transform 150ms ease, box-shadow 150ms ease;
	}

	.reserva-option:hover {
		transform: translateY(-2px);
		box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
	}

	.reserva-option strong {
		font-size: 1.45rem;
		text-transform: uppercase;
	}

	.reserva-option span {
		font-size: 0.98rem;
		color: rgba(255, 255, 255, 0.88);
	}

	.reserva-option.kids {
		background: linear-gradient(135deg, #e7a708, #ffc928);
		color: #0f1d39;
	}

	.reserva-option.kids span {
		color: rgba(15, 29, 57, 0.84);
	}

	.reserva-option.junior {
		background: linear-gradient(135deg, #1736a8, #2a58ff);
	}

	.reserva-option.elite {
		background: linear-gradient(135deg, #d5141a, #ff2b27);
	}

	.schedule-contact-section {
		background: #0b0d12;
		color: #ffffff;
		padding: 0 0 1.8rem;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1fr 1fr 0.9fr 0.86fr;
		gap: 2.2rem;
		padding-top: 1.7rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		align-items: stretch;
	}

	.footer-brand p,
	.footer-social {
		max-width: 19rem;
	}

	.footer-brand,
	.footer-contact,
	.footer-feed,
	.footer-map-panel {
		position: relative;
		height: 100%;
	}

	.footer-contact,
	.footer-feed,
	.footer-map-panel {
		padding-left: 1.5rem;
		border-left: 1px solid rgba(255, 255, 255, 0.12);
	}

	.footer-social {
		display: flex;
		gap: 0.8rem;
		margin-top: 1.2rem;
		align-items: center;
	}

	.social-icon {
		width: 2.2rem;
		height: 2.2rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: #ffffff;
		background: transparent;
		opacity: 0.96;
		transition: transform 180ms ease, color 180ms ease, opacity 180ms ease;
	}

	.social-icon svg {
		width: 1.9rem;
		height: 1.9rem;
		fill: currentColor;
		stroke: none;
	}

	.social-icon:hover {
		color: #ff2d26;
		opacity: 1;
		transform: translateY(-2px);
	}

	.footer-contact,
	.footer-feed,
	.footer-map-panel {
		display: grid;
		align-content: start;
		gap: 0.6rem;
	}

	.footer-contact h3,
	.footer-feed h3 {
		margin: 0 0 0.8rem;
		font-size: 1.15rem;
		font-weight: 900;
		text-transform: uppercase;
		color: #ffffff;
	}

	.footer-contact p {
		margin: 0;
	}

	.footer-contact p {
		font-size: 0.97rem;
		color: #d1d7e5;
		line-height: 1.6;
	}

	.contact-line {
		display: grid;
		grid-template-columns: 1.1rem 1fr;
		gap: 0.8rem;
		align-items: start;
	}

	.contact-icon {
		color: #ff2d26;
		line-height: 0;
		margin-top: 0.2rem;
	}

	.contact-icon svg {
		width: 1.05rem;
		height: 1.05rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.footer-map {
		position: relative;
		min-height: 7.1rem;
		margin-top: 0.15rem;
		border-radius: 0.55rem;
		border: 1px solid rgba(255, 255, 255, 0.08);
		overflow: hidden;
		background: #121722;
	}

	.footer-map iframe {
		width: 100%;
		height: 100%;
		min-height: 7.1rem;
		border: 0;
		display: block;
		filter: grayscale(0.08) contrast(1.02) saturate(0.95);
	}

	.footer-brand {
		display: grid;
		align-content: start;
		gap: 0.75rem;
	}

	.footer-logo-image {
		width: min(100%, 17rem);
	}

	.footer-brand p {
		margin: 0.15rem 0 0;
		font-size: 0.9rem;
		color: #d1d7e5;
		line-height: 1.5;
	}

	.footer-feed p {
		margin: -0.3rem 0 0.2rem;
		font-size: 0.94rem;
		color: #d1d7e5;
	}

	.footer-feed-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.35rem;
		align-items: stretch;
	}

	.footer-feed-grid img {
		width: 100%;
		height: 4.8rem;
		object-fit: cover;
		object-position: center;
		display: block;
		border-radius: 0.2rem;
		border: 1px solid rgba(255, 255, 255, 0.08);
		overflow: hidden;
	}

	.footer-contact .button {
		min-height: 3.1rem;
		border-radius: 0.85rem;
		margin-top: 0.2rem;
	}

	@media (max-width: 1180px) {
		.hero-shell,
		.about-shell,
		.updates-grid,
		.cta-shell,
		.footer-grid {
			grid-template-columns: 1fr;
		}

		.feature-band,
		.class-grid,
		.pricing-grid,
		.stats-grid {
			grid-template-columns: 1fr 1fr;
		}

		.schedule-board,
		.schedule-notes {
			grid-template-columns: 1fr;
		}

		.hero-shell {
			min-height: auto;
			background:
				linear-gradient(180deg, #05070d 0%, #05070d 54%, rgba(5, 7, 13, 0.92) 69%, rgba(5, 7, 13, 0.76) 100%);
		}

		.hero-copy {
			padding: 2rem 1.7rem 1.5rem;
		}

		.hero-media {
			min-height: 28rem;
		}

		.hero-media img {
			object-position: center top;
		}

		.hero-side-copy {
			right: 1.4rem;
			bottom: 1.7rem;
			font-size: clamp(1.7rem, 4.2vw, 2.4rem);
		}

		.about-copy {
			max-width: none;
			margin: 0;
		}

		.about-gallery {
			grid-template-columns: 1fr 1fr;
			grid-template-rows: 12rem 12rem 12rem;
		}

		.about-gallery .about-main {
			grid-column: 1 / -1;
			grid-row: auto;
		}

		.cta-button {
			margin: 0 1.2rem 1.2rem;
		}

		.gallery-grid {
			grid-template-columns: 1fr 1fr;
			grid-template-rows: 9rem 9rem;
		}

		.footer-contact,
		.footer-feed,
		.footer-map-panel {
			padding-left: 0;
			border-left: 0;
			padding-top: 1.1rem;
			border-top: 1px solid rgba(255, 255, 255, 0.1);
		}
	}

	@media (max-width: 760px) {
		.header-row {
			grid-template-columns: auto minmax(0, 1fr) auto;
			grid-template-areas: 'menu brand lang';
			align-items: center;
			justify-items: stretch;
			gap: 0.65rem;
			padding: 0.7rem 0;
			min-height: auto;
			position: relative;
		}

		.brand {
			grid-area: brand;
			justify-self: start;
			min-width: 0;
		}

		.brand-logo-full {
			width: min(100%, 13.6rem);
		}

		.menu-toggle {
			display: inline-flex;
			grid-area: menu;
			justify-self: start;
		}

		.site-header.menu-open .menu-toggle span:nth-child(1) {
			transform: translateY(0.4rem) rotate(45deg);
		}

		.site-header.menu-open .menu-toggle span:nth-child(2) {
			opacity: 0;
		}

		.site-header.menu-open .menu-toggle span:nth-child(3) {
			transform: translateY(-0.4rem) rotate(-45deg);
		}

		.nav {
			position: absolute;
			top: calc(100% + 0.35rem);
			left: 0;
			right: 0;
			display: none;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 0.55rem;
			font-size: 0.98rem;
			line-height: 1.15;
			border-radius: 1rem;
			background: rgba(10, 12, 18, 0.98);
			border: 1px solid rgba(255, 255, 255, 0.08);
			box-shadow: 0 20px 40px rgba(0, 0, 0, 0.32);
			z-index: 30;
		}

		.site-header.menu-open .nav {
			display: flex;
		}

		.nav a {
			padding: 0.95rem 0.75rem;
			text-align: left;
			border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		}

		.nav a:last-child {
			border-bottom: 0;
		}

		.nav a::after {
			display: none;
		}

		.header-languages {
			display: none;
		}

		.header-language-select {
			display: none;
		}

		.mobile-language-menu {
			grid-area: lang;
			display: block;
			justify-self: end;
		}

		.mobile-language-trigger,
		.mobile-language-option {
			width: 2.55rem;
			height: 2.1rem;
		}

		.mobile-language-flag {
			width: 1.38rem;
			height: 1.38rem;
		}

		.feature-band,
		.class-grid,
		.pricing-grid,
		.stats-grid {
			grid-template-columns: 1fr;
		}

		.reasons-grid {
			grid-template-columns: 1fr 1fr;
		}

		.schedule-board {
			grid-template-columns: minmax(7.75rem, 8.5rem) repeat(4, minmax(8.5rem, 1fr));
			min-width: 42rem;
		}

		.schedule-header {
			font-size: 0.86rem;
			padding: 0.85rem 0.4rem;
			min-width: 8.75rem;
		}

		.schedule-time,
		.schedule-cell {
			min-height: 5.5rem;
			font-size: 1rem;
			min-width: 8.75rem;
		}

		.schedule-time strong {
			font-size: 1.2rem;
		}

		.schedule-time-icon {
