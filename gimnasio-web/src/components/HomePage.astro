	@media (max-width: 760px) {
		.news-grid {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.news-card {
			grid-template-rows: 14.5rem auto;
		}

		.header-row {
			grid-template-columns: auto minmax(0, 1fr) auto;
			grid-template-areas: 'menu brand lang';
			align-items: center;
			justify-items: stretch;
			gap: 0.65rem;
			padding: 0.7rem 0;
			min-height: auto;
			position: relative;
