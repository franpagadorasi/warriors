	.reviews-button:hover {
		transform: translateY(-2px);
		box-shadow: 0 14px 26px rgba(227, 29, 28, 0.3);
		background: linear-gradient(135deg, #ff2d26, #ff4a34);
	}

	.footer-contact .button {
		min-height: 3.35rem;
		margin-top: 0.2rem;
	}

	@media (max-width: 1180px) {
		.hero-shell,
		.about-shell,
		.updates-grid,
		.cta-shell,
		.footer-grid {
			grid-template-columns: 1fr;
		}

		.feature-band,
		.class-grid,
		.pricing-grid,
		.stats-grid,
		.conversion-panel-actions {
			grid-template-columns: 1fr 1fr;
		}

		.schedule-board,
		.schedule-notes,
		.conversion-panel {
			grid-template-columns: 1fr;
		}

		.hero-shell {
			min-height: auto;
			background: #000;
		}

		.hero-copy {
			padding: 2rem 1.7rem 1.5rem;
		}

		.hero-media {
			min-height: 28rem;
		}

		.hero-media img {
			object-position: center top;
		}

		.hero-side-copy {
			right: 1.4rem;
			bottom: 1.7rem;
			font-size: clamp(1.7rem, 4.2vw, 2.4rem);
		}

