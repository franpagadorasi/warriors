---
import Layout from '../layouts/Layout.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import { getSiteCopy, type Locale } from '../lib/site-copy';
import { aboutPaths } from '../lib/about-copy';

interface Props {
	locale?: Locale;
}

const { locale = 'ca' } = Astro.props;
const copy = getSiteCopy(locale);

const formatNewsDate = (date: string) => {
	const parsed = new Date(date);
	if (Number.isNaN(parsed.getTime())) return date;
	const monthMap: Record<Locale, string[]> = {
		ca: ['GEN', 'FEB', 'MAR', 'ABR', 'MAI', 'JUN', 'JUL', 'AGO', 'SET', 'OCT', 'NOV', 'DES'],
		es: ['ENE', 'FEB', 'MAR', 'ABR', 'MAY', 'JUN', 'JUL', 'AGO', 'SEP', 'OCT', 'NOV', 'DIC'],
		en: ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC']
	};
	const months = monthMap[locale];
	return `${String(parsed.getUTCDate()).padStart(2, '0')} ${months[parsed.getUTCMonth()]} ${parsed.getUTCFullYear()}`;
};

const galleryItems = [...copy.gallery.items].sort((a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured)));
const newsItems = copy.news.items;
const clubAddress = copy.footer.address;
const mapEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(clubAddress)}&output=embed`;
const mapDirectionsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(clubAddress)}`;
const googleReviewsUrl =
	'https://www.google.com/search?sa=X&sca_esv=72d5cd2ff8b49349&hl=es-ES&sxsrf=APpeQnteq4VAaMWerGiHchsD0iSncs0cfA:1786449416188&q=Club+Taekwondo+Warriors+Rese%C3%B1as&rflfq=1&num=20&stick=H4sIAAAAAAAAAONgkxIxNDMzMjA2NjSxMLUwMTayNDEwMdjAyPiKUcE5pzRJISQxNbs8Py8lXyE8sagoM7-oWCEotTj18MbE4kWsBJUAAHwBsRVhAAAA&rldimm=16620331485843294040&tbm=lcl&ved=2ahUKEwjSg_HWwpiWAxXtSfEDHV_pK2QQ9fQKegQIVRAG&biw=1920&bih=911&dpr=1#lkt=LocalPoiReviews';
const trialWhatsappUrl = `${copy.footer.whatsappUrl}?text=${copy.hero.trialWhatsappMessage}`;
const mobileImageBySrc: Record<string, string> = {
	'/images/optimized/kids-taekwondo.jpg': '/images/optimized/kids-taekwondo-mobile.jpg',
	'/images/optimized/modalidad-combate.jpg': '/images/optimized/modalidad-combate-mobile.jpg',
	'/images/optimized/modalidad-poomsae.jpg': '/images/optimized/modalidad-poomsae-mobile.jpg',
	'/images/optimized/modalidad-defensa.jpg': '/images/optimized/modalidad-defensa-mobile.jpg',
	'/images/optimized/modalidad-exhibicion.jpg': '/images/optimized/modalidad-exhibicion-mobile.jpg',
	'/images/optimized/dojo-interior.jpg': '/images/optimized/dojo-interior-mobile.jpg',
	'/images/optimized/noticia-catalunya-infantil-1.jpg': '/images/optimized/noticia-catalunya-infantil-1-mobile.jpg',
	'/images/optimized/cabecera.jpg': '/images/optimized/cabecera-mobile.jpg',
	'/images/optimized/noticia-medalla-plata.jpg': '/images/optimized/noticia-medalla-plata-mobile.jpg',
	'/images/optimized/cta-diana-kick-right.jpg': '/images/optimized/cta-diana-kick-right-mobile.jpg'
};

const pricingPlans = copy.pricing.plans;
const clubReasons = copy.pricing.reasons;
const weeklySchedule = copy.schedule.rows;
const ageGroups = copy.schedule.ages;
const valuePillars = copy.schedule.values;
const scheduleGroupLogoByTone: Record<string, string> = {
	gold: '/images/warriors-kids.png',
	blue: '/images/warriors-junior.png',
	red: '/images/warriors-elite.png'
};
const localePaths: Record<Locale, string> = { ca: '/', es: '/es/', en: '/en/' };
const seoAlternates = [
	{ lang: 'ca', path: localePaths.ca },
	{ lang: 'es', path: localePaths.es },
	{ lang: 'en', path: localePaths.en }
];
const localeLabels: Record<Locale, string> = { ca: 'Català', es: 'Español', en: 'English' };
const scheduleDayShortLabels: Record<Locale, string[]> = {
	ca: ['Dl', 'Dm', 'Dx', 'Dj'],
	es: ['L', 'M', 'X', 'J'],
	en: ['M', 'T', 'W', 'T']
};
const languageAria: Record<Locale, string> = {
	ca: 'Idiomes disponibles',
	es: 'Idiomas disponibles',
	en: 'Available languages'
};
const aboutHref = aboutPaths[locale];
const closeModalLabel: Record<Locale, string> = {
	ca: 'Tancar',
	es: 'Cerrar',
	en: 'Close'
};
const noClassLabel: Record<Locale, string> = {
	ca: 'Sense classe',
	es: 'Sin clase',
	en: 'No class'
};
const galleryPrevLabel: Record<Locale, string> = {
	ca: 'Imatge anterior',
	es: 'Imagen anterior',
	en: 'Previous image'
};
const galleryNextLabel: Record<Locale, string> = {
	ca: 'Imatge següent',
	es: 'Imagen siguiente',
	en: 'Next image'
};
const sponsorsTitleLabel: Record<Locale, string> = {
	ca: 'FEDERACIÓ I AJUNTAMENT',
	es: 'FEDERACIÓN Y AYUNTAMIENTO',
	en: 'FEDERATION AND TOWN COUNCIL'
};
const sponsorsAriaLabel: Record<Locale, string> = {
	ca: 'Federació i ajuntament',
	es: 'Federación y ayuntamiento',
	en: 'Federation and town council'
};
const sponsorsNoteLabel: Record<Locale, string> = {
	ca: 'La nostra entitat desenvolupa la seva activitat en el marc de la Federació Catalana de Taekwondo i la Real Federación Española de Taekwondo, amb seu d’entrenaments a Sant Vicenç dels Horts.',
	es: 'Nuestra entidad desarrolla su actividad en el marco de la Federación Catalana de Taekwondo y la Real Federación Española de Taekwondo, con sede de entrenamientos en Sant Vicenç dels Horts.',
	en: 'Our organization carries out its activity within the framework of the Catalan Taekwondo Federation and the Royal Spanish Taekwondo Federation, with its training base in Sant Vicenç dels Horts.'
};
const mapTitlePrefix: Record<Locale, string> = {
	ca: 'Mapa de',
	es: 'Mapa de',
	en: 'Map of'
};
const currentYear = new Date().getFullYear();
---

<Layout
	title={copy.seoTitle}
	description={copy.seoDescription}
	lang={copy.lang}
	path={localePaths[locale]}
	ogImage="/images/optimized/cabecera.jpg"
	alternates={seoAlternates}
>
	<header class="site-header">
		<div class="container header-row">
			<a class="brand" href="#inicio">
				<img src="/images/logo-warriors-horizontal.png" alt="Club Taekwondo Warriors" class="brand-logo-full" />
			</a>

			<button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" data-menu-toggle>
				<span></span>
				<span></span>
				<span></span>
			</button>

			<nav class="nav" data-mobile-nav>
				<a class="active" href="#inicio">{copy.nav.home}</a>
				<a href={aboutHref}>{copy.nav.about}</a>
				<a href="#clases">{copy.nav.classes}</a>
				<a href="#cuotas">{copy.nav.pricing}</a>
				<a href="#horarios">{copy.nav.schedule}</a>
				<a href="#noticias">{copy.nav.news}</a>
				<a href="#galeria-destacada">{copy.nav.gallery}</a>
				<a href="#contacto">{copy.nav.contact}</a>
			</nav>

			<div class="header-languages" aria-label={languageAria[locale]}>
				<a class={`language-flag ${locale === 'ca' ? 'active' : ''}`} href={localePaths.ca} aria-label="Català" title="Català"></a>
				<a class={`language-flag ${locale === 'es' ? 'active' : ''}`} href={localePaths.es} aria-label="Español" title="Español"></a>
				<a class={`language-flag ${locale === 'en' ? 'active' : ''}`} href={localePaths.en} aria-label="English" title="English"></a>
			</div>

			<div class="header-language-select">
				<label class="sr-only" for="mobile-language-select">{languageAria[locale]}</label>
				<select
					id="mobile-language-select"
					class="language-select"
					aria-label={languageAria[locale]}
					onchange="window.location.href=this.value"
				>
					<option value={localePaths.ca} selected={locale === 'ca'}>Català</option>
					<option value={localePaths.es} selected={locale === 'es'}>Español</option>
					<option value={localePaths.en} selected={locale === 'en'}>English</option>
				</select>
			</div>

			<div class="mobile-language-menu" data-language-menu>
				<button
					class={`mobile-language-trigger flag-${locale}`}
					type="button"
					aria-label={languageAria[locale]}
					aria-expanded="false"
					data-language-toggle
				>
					<span class="mobile-language-flag" aria-hidden="true"></span>
					<span class="mobile-language-caret" aria-hidden="true"></span>
				</button>
				<div class="mobile-language-options" data-language-options>
					<a class={`mobile-language-option flag-ca ${locale === 'ca' ? 'active' : ''}`} href={localePaths.ca} aria-label={localeLabels.ca} title={localeLabels.ca}>
						<span class="mobile-language-flag" aria-hidden="true"></span>
					</a>
					<a class={`mobile-language-option flag-es ${locale === 'es' ? 'active' : ''}`} href={localePaths.es} aria-label={localeLabels.es} title={localeLabels.es}>
						<span class="mobile-language-flag" aria-hidden="true"></span>
					</a>
					<a class={`mobile-language-option flag-en ${locale === 'en' ? 'active' : ''}`} href={localePaths.en} aria-label={localeLabels.en} title={localeLabels.en}>
						<span class="mobile-language-flag" aria-hidden="true"></span>
					</a>
				</div>
			</div>
		</div>
	</header>

	<main>
		<section class="hero" id="inicio">
			<div class="container hero-shell">
				<div class="hero-copy">
					<p class="hero-kicker">{copy.hero.eyebrow}</p>
					<h1 class="hero-title">
						<span class="hero-title-main">{copy.hero.titleMain}</span>
						<span class="hero-title-accent">{copy.hero.titleAccent}</span>
					</h1>
					<p class="hero-values">{copy.hero.values}</p>
					<p class="hero-chant">{copy.hero.chant}</p>
					<p class="hero-text">{copy.hero.description}</p>

					<div class="hero-actions">
						<a class="button button-primary" href={trialWhatsappUrl} target="_blank" rel="noreferrer">{copy.hero.primaryCta}</a>
						<a class="button button-secondary" href="#club">{copy.hero.secondaryCta}</a>
					</div>
				</div>

				<div class="hero-media">
					<div class="hero-ring" aria-hidden="true"></div>
					<img src="/images/hero-taekwondo.jpeg" alt={copy.hero.imageAlt} />
					<div class="hero-side-copy">
						{copy.hero.sideWords.map((word) => <p>{word}</p>)}
					</div>
				</div>
			</div>

			<div class="container feature-band">
				{copy.features.map((item) => (
					<article class={`feature-card ${item.tone ?? 'red'}`}>
						<div class="feature-icon"></div>
						<div>
							<h2>{item.title}</h2>
							<p>{item.description}</p>
							{item.highlight && <p class="feature-highlight">{item.highlight}</p>}
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="about-section" id="club">
			<div class="container">
				<div class="section-title-line about-title-line">
					<span></span>
					<h2 class="section-title center-title unified-title">{copy.about.kicker}</h2>
					<span></span>
				</div>
			</div>
			<div class="container about-shell">
				<div class="about-copy">
					<h3 class="about-lead">{copy.about.title}</h3>
					<p class="section-copy">{copy.about.description}</p>
					<a class="button button-blue" href={aboutHref}>{copy.about.cta}</a>
				</div>

				<div class="about-gallery" id="galeria">
					<img class="about-main" src="/images/sobre-11.jpeg" alt={copy.about.imagesAlt[0]} />
					<img src="/images/sobre-10.jpeg" alt={copy.about.imagesAlt[1]} />
					<img src="/images/sobre-17.jpeg" alt={copy.about.imagesAlt[2]} />
					<img src="/images/sobre-18.jpeg" alt={copy.about.imagesAlt[3]} />
					<img src="/images/sobre-22.jpeg" alt={copy.about.imagesAlt[4]} />
				</div>
			</div>
		</section>

		<section class="classes-section" id="clases">
			<div class="container">
				<div class="section-title-line">
					<span></span>
					<h2 class="section-title center-title unified-title">{copy.classes.title}</h2>
					<span></span>
				</div>

				<div class="class-grid">
					{copy.classes.items.map((item) => (
						<article class="class-card">
							<div class="class-thumb">
								<ResponsiveImage
									src={item.imageUrl}
									mobileSrc={mobileImageBySrc[item.imageUrl]}
									alt={item.title}
									loading="lazy"
									decoding="async"
								/>
							</div>

							<div class="class-copy">
								<h3>{item.title}</h3>
								<p>{item.description}</p>

								<div class="class-meta">
									<span>{item.audience}</span>
								</div>
							</div>
						</article>
					))}
				</div>

			</div>
		</section>

		<section class="pricing-section" id="cuotas">
			<div class="container">
				<div class="pricing-header">
					<div class="pricing-heading-line">
						<span></span>
						<p>{copy.pricing.title}</p>
						<span></span>
					</div>
				</div>

				<div class="pricing-grid">
					{pricingPlans.map((plan) => (
						<article class={`pricing-card ${plan.tone}`}>
							{plan.badge && <span class="pricing-badge">{plan.badge}</span>}
							<div class="pricing-belt" aria-hidden="true">
								<img src={`/images/belt-${plan.tone}-poster.png`} alt="" loading="lazy" />
							</div>

							<div class="pricing-head">
								<p class="pricing-plan-label">{copy.pricing.cardLabel}</p>
								<h3>{plan.name.replace(/^(Quota|Cuota|Plan)\s/i, '')}</h3>
								<p>{plan.subtitle}</p>
							</div>

							<div class="pricing-divider" aria-hidden="true">
								<span></span>
								<div class="pricing-star"></div>
								<span></span>
							</div>

							<ul class="pricing-list">
								{plan.items.map((item) => (
									<li>
										<span class={`feature-icon-svg ${plan.tone}`}>
											{
												item.icon === 'calendar' && (
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<rect x="3" y="5" width="18" height="16" rx="2"></rect>
														<path d="M8 3v4M16 3v4M3 10h18"></path>
													</svg>
												)
											}
											{
												item.icon === 'user' && (
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<circle cx="12" cy="8" r="4"></circle>
														<path d="M5 20c1.8-3.5 4.2-5 7-5s5.2 1.5 7 5"></path>
													</svg>
												)
											}
											{
												item.icon === 'target' && (
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<circle cx="12" cy="12" r="8"></circle>
														<circle cx="12" cy="12" r="4"></circle>
														<circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"></circle>
													</svg>
												)
											}
											{
												item.icon === 'shield' && (
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<path d="M12 3l7 3v5c0 4.7-2.4 7.8-7 10-4.6-2.2-7-5.3-7-10V6l7-3z"></path>
														<path d="M9.5 12.5l1.7 1.7 3.5-4"></path>
													</svg>
												)
											}
											{
												item.icon === 'growth' && (
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<path d="M4 19V10M10 19V6M16 19v-8M4 19h16"></path>
														<path d="M13 8l4-4 3 3"></path>
													</svg>
												)
											}
											{
												item.icon === 'cap' && (
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<path d="M3 9l9-4 9 4-9 4-9-4z"></path>
														<path d="M7 11v4c2.4 1.8 7.6 1.8 10 0v-4"></path>
														<path d="M21 9v6"></path>
													</svg>
												)
											}
											{
												item.icon === 'arm' && (
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<path d="M8 13c1-2 1.3-4.8 3-5.5 1.5-.6 2.3 1.1 2.2 2.5 1.3-.5 2.9 0 3.5 1.3.7 1.4-.1 3.1-1.1 4.2-1.8 2.1-4 3.5-7.6 3.5-2.7 0-4.5-1.2-4.5-3.4 0-1.4 1.1-2.6 2.7-2.6H8z"></path>
														<path d="M9.5 7.5l1.5 1.8"></path>
													</svg>
												)
											}
											{
												item.icon === 'trophy' && (
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<path d="M8 4h8v4a4 4 0 0 1-8 0V4z"></path>
														<path d="M9 14h6M10 14v4M14 14v4M8 20h8"></path>
														<path d="M8 6H5a3 3 0 0 0 3 4M16 6h3a3 3 0 0 1-3 4"></path>
													</svg>
												)
											}
											{
												item.icon === 'kick' && (
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<circle cx="8.5" cy="5.5" r="2"></circle>
														<path d="M10 8l2.5 2.5 3.5 1M12.5 10.5l-2 4-3 2.5M10.5 12l4 4M7.5 17l1.5 3M15.5 11.5l4.5-1.5"></path>
													</svg>
												)
											}
											{
												item.icon === 'barbell' && (
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<path d="M3 10v4M6 8v8M9 9v6M15 9v6M18 8v8M21 10v4M9 12h6"></path>
													</svg>
												)
											}
										</span>
										<span>{item.text}</span>
									</li>
								))}
							</ul>

							<div class="pricing-price">
								<div class="pricing-brush" aria-hidden="true"></div>
								<strong>{plan.price}<span class="pricing-currency">&euro;</span></strong>
								<span>{plan.frequency}</span>
							</div>
						</article>
					))}
				</div>

				<div class="reasons-row">
					<p class="reasons-title">{copy.pricing.reasonsTitle}</p>
					<div class="reasons-grid">
						{clubReasons.map((reason) => (
							<article class="reason-item">
								<span class="reason-icon">
									{
										reason.icon === 'rings' && (
											<svg viewBox="0 0 90 36" aria-hidden="true">
												<circle cx="15" cy="14" r="11"></circle>
												<circle cx="37" cy="14" r="11"></circle>
												<circle cx="59" cy="14" r="11"></circle>
												<circle cx="26" cy="23" r="11"></circle>
												<circle cx="48" cy="23" r="11"></circle>
											</svg>
										)
									}
									{
										reason.icon === 'teacher' && (
											<img src="/images/iconos/profesores_titulados.png" alt="" class="reason-icon-image reason-icon-image-teacher" />
										)
									}
									{
										reason.icon === 'belt' && (
											<img src="/images/iconos/examenes_grado.jpeg" alt="" class="reason-icon-image reason-icon-image-belt" />
										)
									}
									{
										reason.icon === 'kick' && (
											<img src="/images/iconos/participacion_exhibiciones.jpeg" alt="" class="reason-icon-image reason-icon-image-kick" />
										)
									}
									{
										reason.icon === 'podium' && (
											<img src="/images/iconos/equipo_competicion.jpeg" alt="" class="reason-icon-image reason-icon-image-podium" />
										)
									}
									{
										reason.icon === 'group' && (
											<img src="/images/iconos/ambiente_familiar.png" alt="" class="reason-icon-image reason-icon-image-group" />
										)
									}
								</span>
								<span>{reason.text}</span>
							</article>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="conversion-panel-section" aria-labelledby="conversion-panel-title">
			<div class="container">
				<div class="conversion-panel">
					<div class="conversion-panel-copy">
						<h2 id="conversion-panel-title">{copy.conversion.panelTitle}</h2>
						<p>{copy.conversion.panelDescription}</p>
					</div>
					<div class="conversion-panel-actions">
						<button class="conversion-action conversion-action-primary" type="button" data-open-reserva-modal>
							<strong>{copy.conversion.reserveLabel}</strong>
							<span>{copy.conversion.reserveNote}</span>
						</button>
						<a class="conversion-action conversion-action-whatsapp" href={trialWhatsappUrl} target="_blank" rel="noreferrer">
							<strong>{copy.conversion.whatsappLabel}</strong>
							<span>{copy.conversion.whatsappNote}</span>
						</a>
					</div>
				</div>
			</div>
		</section>

		<section class="schedule-showcase" id="horarios">
			<div class="container">
				<div class="section-title-line">
					<span></span>
					<h2 class="section-title center-title unified-title">{copy.schedule.title}</h2>
					<span></span>
				</div>

				<div class="schedule-board-wrap">
					<div class="schedule-board">
					<div class="schedule-header">{copy.schedule.headerTime}</div>
					{copy.schedule.days.map((day, index) => <div class="schedule-header schedule-day-header" data-short={scheduleDayShortLabels[locale][index]}>{day}</div>)}

						{weeklySchedule.map((row) => (
						<>
							<div class={`schedule-time ${row.tone}`}>
								<span class="schedule-time-icon" aria-hidden="true"></span>
								<strong>{row.time}</strong>
							</div>
							{row.classes.map((item) => (
								<div class={`schedule-cell ${row.tone} ${!item ? 'empty' : ''}`} aria-label={item || noClassLabel[locale]}>
									{
										item && (
											<span>
