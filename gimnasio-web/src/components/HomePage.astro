	<script is:inline>
		(() => {
			document.body.style.overflow = '';

			const initMobileMenu = () => {
				const header = document.querySelector('.site-header');
				const toggle = document.querySelector('[data-menu-toggle]');
				const nav = document.querySelector('[data-mobile-nav]');

				if (!(header instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;

				const closeMenu = () => {
					header.classList.remove('menu-open');
					header.classList.remove('language-open');
					toggle.setAttribute('aria-expanded', 'false');
					document.body.style.overflow = '';
				};

				const openMenu = () => {
					header.classList.add('menu-open');
					toggle.setAttribute('aria-expanded', 'true');
					document.body.style.overflow = 'hidden';
				};

				toggle.addEventListener('click', () => {
					if (header.classList.contains('menu-open')) {
						closeMenu();
					} else {
						openMenu();
					}
				});

				nav.querySelectorAll('a, button[data-open-reserva-modal]').forEach((link) => {
					link.addEventListener('click', closeMenu);
				});

				window.addEventListener('resize', () => {
					if (window.innerWidth > 760) {
						closeMenu();
					}
				});

				const languageToggle = document.querySelector('[data-language-toggle]');
				const languageOptions = document.querySelector('[data-language-options]');

				if (languageToggle instanceof HTMLButtonElement && languageOptions instanceof HTMLElement) {
					const closeLanguageMenu = () => {
						header.classList.remove('language-open');
						languageToggle.setAttribute('aria-expanded', 'false');
					};

					const openLanguageMenu = () => {
						header.classList.add('language-open');
						languageToggle.setAttribute('aria-expanded', 'true');
					};

					languageToggle.addEventListener('click', (event) => {
						event.stopPropagation();
						if (header.classList.contains('language-open')) {
							closeLanguageMenu();
						} else {
							openLanguageMenu();
						}
					});

					languageOptions.querySelectorAll('a').forEach((link) => {
						link.addEventListener('click', closeLanguageMenu);
					});

					document.addEventListener('click', (event) => {
						const target = event.target;
						if (!(target instanceof Node)) return;
						if (!languageOptions.contains(target) && !languageToggle.contains(target)) {
							closeLanguageMenu();
						}
					});
				}
			};

			const initReservaModal = () => {
				const overlay = document.querySelector('[data-reserva-overlay]');
				const openButtons = document.querySelectorAll('[data-open-reserva-modal]');
				const closeButtons = document.querySelectorAll('[data-close-reserva-modal]');

				if (!(overlay instanceof HTMLElement) || openButtons.length === 0) return;

				const openModal = () => {
					overlay.hidden = false;
					document.body.style.overflow = 'hidden';
				};

				const closeModal = () => {
					overlay.hidden = true;
					document.body.style.overflow = '';
				};

				window.__openReservaModal = openModal;
				window.__closeReservaModal = closeModal;

				openButtons.forEach((button) => {
					button.addEventListener('click', openModal);
				});

				closeButtons.forEach((button) => {
					button.addEventListener('click', closeModal);
				});

				document.addEventListener('keydown', (event) => {
					if (event.key === 'Escape' && !overlay.hidden) {
						closeModal();
					}
				});
			};

			const initGalleryCarousel = () => {
				const carousel = document.querySelector('[data-gallery-carousel]');
				if (!(carousel instanceof HTMLElement)) return;

				const track = carousel.querySelector('[data-gallery-track]');
				const prevButton = carousel.querySelector('[data-gallery-prev]');
				const nextButton = carousel.querySelector('[data-gallery-next]');
				const dots = Array.from(carousel.querySelectorAll('[data-gallery-dot]'));

				if (!(track instanceof HTMLElement) || dots.length === 0) return;

				let currentIndex = 0;
				let autoplayId = 0;

				const updateCarousel = (index) => {
					const boundedIndex = (index + dots.length) % dots.length;
					currentIndex = boundedIndex;
					track.style.transform = `translateX(-${boundedIndex * 100}%)`;

					dots.forEach((dot, dotIndex) => {
						if (!(dot instanceof HTMLButtonElement)) return;
						const isActive = dotIndex === boundedIndex;
						dot.classList.toggle('is-active', isActive);
						dot.setAttribute('aria-pressed', isActive ? 'true' : 'false');
					});
				};

				const startAutoplay = () => {
					window.clearInterval(autoplayId);
					autoplayId = window.setInterval(() => {
						updateCarousel(currentIndex + 1);
					}, 4200);
				};

				const stopAutoplay = () => {
					window.clearInterval(autoplayId);
				};

				if (prevButton instanceof HTMLButtonElement) {
					prevButton.addEventListener('click', () => {
						updateCarousel(currentIndex - 1);
						startAutoplay();
					});
				}

				if (nextButton instanceof HTMLButtonElement) {
					nextButton.addEventListener('click', () => {
						updateCarousel(currentIndex + 1);
						startAutoplay();
					});
				}

				dots.forEach((dot, dotIndex) => {
					if (!(dot instanceof HTMLButtonElement)) return;
					dot.addEventListener('click', () => {
						updateCarousel(dotIndex);
						startAutoplay();
					});
				});

				carousel.addEventListener('mouseenter', stopAutoplay);
				carousel.addEventListener('mouseleave', startAutoplay);
				carousel.addEventListener('focusin', stopAutoplay);
				carousel.addEventListener('focusout', startAutoplay);

				updateCarousel(0);
				startAutoplay();
			};

			if (document.readyState === 'loading') {
				document.addEventListener(
					'DOMContentLoaded',
					() => {
						initMobileMenu();
