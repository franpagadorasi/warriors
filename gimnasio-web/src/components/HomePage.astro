	.reviews-card-top {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.8rem;
		align-items: center;
	}

	.reviews-google-mark {
		width: 2.55rem;
		height: 2.55rem;
		border-radius: 999px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 1.35rem;
		font-weight: 900;
		color: #ffffff;
		background: conic-gradient(from 210deg, #34a853, #4285f4, #ea4335, #fbbc05, #34a853);
		box-shadow: 0 10px 18px rgba(0, 0, 0, 0.18);
