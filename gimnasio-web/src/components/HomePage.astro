		overflow: hidden;
	}

	.gallery-viewport {
		overflow: hidden;
		border-radius: 1.35rem;
	}

	.gallery-track {
		display: flex;
		transition: transform 420ms ease;
		will-change: transform;
	}

	.gallery-slide {
		flex: 0 0 100%;
		min-width: 100%;
	}

	.gallery-slide .gallery-card {
		aspect-ratio: 16 / 7.1;
	}

	.gallery-card {
		display: grid;
		place-items: center;
		background:
			radial-gradient(circle at top, rgba(28, 87, 232, 0.06), transparent 38%),
			#ffffff;
	}

	.gallery-card :global(.gallery-image-picture) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.gallery-controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.7rem;
	}

	.gallery-nav {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 3rem;
		height: 3rem;
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.96);
		color: #0f172a;
		box-shadow: 0 14px 28px rgba(15, 23, 42, 0.12);
		font-size: 0;
		line-height: 1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		z-index: 2;
		transition:
			transform 160ms ease,
			box-shadow 160ms ease,
			background 160ms ease,
			opacity 160ms ease;
	}

	.gallery-nav-prev {
		left: 0.7rem;
	}

	.gallery-nav-next {
		right: 0.7rem;
	}

	.gallery-nav:hover {
		transform: translateY(-50%) scale(1.05);
		box-shadow: 0 18px 32px rgba(15, 23, 42, 0.18);
		background: #ffffff;
		border-color: rgba(227, 29, 28, 0.18);
	}

	.gallery-nav::before {
		font-size: 2rem;
		font-weight: 500;
		line-height: 1;
		color: #10245f;
		transform: translateY(-0.05rem);
	}

	.gallery-nav-prev::before {
		content: '‹';
	}

	.gallery-nav-next::before {
		content: '›';
	}

	.gallery-nav-arrow {
		display: none;
	}

	.gallery-dots {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
	}

	.gallery-dot {
		width: 0.72rem;
		height: 0.72rem;
		border: 0;
		border-radius: 999px;
		background: rgba(16, 36, 95, 0.18);
		cursor: pointer;
		transition:
			transform 160ms ease,
			background 160ms ease,
			width 160ms ease;
	}

	.gallery-dot.is-active {
		width: 2rem;
		background: #e31d1c;
	}

	.gallery-card :global(.gallery-image) {
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center center;
		display: block;
	}

	.cta-banner {
		padding: 0 0 2.55rem;
		background: #f5f5f5;
	}

	.cta-shell {
		display: grid;
		grid-template-columns: 1fr 1.45fr auto;
		align-items: center;
		gap: 0;
		padding: 0;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.04), transparent 35%),
			linear-gradient(180deg, #101114 0%, #17181c 100%);
		overflow: hidden;
		border-radius: 0;
		border: 0;
		box-shadow: 0 22px 40px rgba(15, 18, 28, 0.14);
		position: relative;
		min-height: 23rem;
	}

	.cta-shell::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(255, 255, 255, 0.03), transparent 22%, transparent 78%, rgba(255, 255, 255, 0.03)),
			radial-gradient(circle at 78% 40%, rgba(227, 29, 28, 0.14), transparent 18%);
		pointer-events: none;
	}

	.cta-image {
		min-height: 23rem;
		height: 100%;
		position: relative;
	}

	.cta-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.cta-image::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(0, 0, 0, 0.12), transparent 22%, transparent 72%, rgba(0, 0, 0, 0.38)),
			linear-gradient(180deg, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.12));
	}

	.cta-copy {
		padding: 1.7rem 2.75rem 1.4rem 2.15rem;
		position: relative;
		z-index: 1;
		align-self: stretch;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
	}

	.cta-copy h2 {
		margin: 0;
		max-width: 19ch;
		font-size: clamp(3.2rem, 5.2vw, 5.6rem);
		color: #ffd24a;
		text-transform: uppercase;
		line-height: 1.36;
		letter-spacing: 0.015em;
	}

	.cta-copy p {
		margin: auto 0 0;
		color: #d7ddeb;
		max-width: 34ch;
		font-size: 1rem;
		line-height: 1.35;
	}

	.cta-actions {
		display: grid;
		gap: 0.8rem;
		margin: auto 2.2rem 1.5rem auto;
		position: relative;
		z-index: 1;
		align-self: end;
	}

	.cta-button {
		min-width: 15rem;
		box-shadow: 0 12px 26px rgba(227, 29, 28, 0.28);
		position: relative;
		z-index: 1;
		align-self: end;
		border: 0;
		cursor: pointer;
		appearance: none;
	}

	.reserva-overlay {
		position: fixed;
		inset: 0;
		display: grid;
		place-items: center;
		padding: 1rem;
		z-index: 120;
	}

	.reserva-overlay[hidden] {
		display: none;
	}

	.modal-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(6, 8, 14, 0.72);
		backdrop-filter: blur(6px);
	}

	.reserva-modal {
		position: relative;
		z-index: 1;
		width: min(34rem, 100%);
		background: linear-gradient(180deg, #101114 0%, #181a1f 100%);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 1.4rem;
		box-shadow: 0 28px 56px rgba(0, 0, 0, 0.35);
		padding: 1.6rem;
		color: #ffffff;
	}

	.reserva-modal-kicker {
		margin: 0 0 0.4rem;
		color: #ffd24a;
		font-size: 0.95rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.reserva-modal h2 {
		margin: 0;
		font-size: clamp(2.1rem, 4vw, 3.1rem);
		line-height: 0.95;
		text-transform: uppercase;
	}

	.reserva-modal-copy {
		margin: 0.8rem 0 1.2rem;
		font-size: 1rem;
		line-height: 1.45;
		color: #d7ddeb;
	}

	.reserva-modal-close {
		position: absolute;
		top: 0.8rem;
		right: 0.8rem;
		width: 2.4rem;
		height: 2.4rem;
		border: 0;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.08);
		color: #ffffff;
		font-size: 1.5rem;
		cursor: pointer;
	}

	.reserva-options {
		display: grid;
		gap: 0.8rem;
	}

	.reserva-option {
		display: grid;
		grid-template-columns: 10rem minmax(0, 1fr);
		align-items: center;
		gap: 1rem;
		padding: 1rem 1.05rem;
		border-radius: 1rem;
		color: #ffffff;
		border: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
		transition: transform 150ms ease, box-shadow 150ms ease;
	}

	.reserva-option:hover {
		transform: translateY(-2px);
		box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
	}

	.reserva-option-logo {
		width: 100%;
		max-width: 8.9rem;
		height: auto;
		display: block;
		object-fit: contain;
	}

	.reserva-option-copy {
		display: flex;
		align-items: center;
		min-height: 100%;
	}

	.reserva-option span {
		font-size: 1.18rem;
		font-weight: 800;
		line-height: 1.2;
		color: rgba(255, 255, 255, 0.88);
	}

	.reserva-option.kids {
		background: linear-gradient(135deg, #e7a708, #ffc928);
		color: #0f1d39;
	}

	.reserva-option.kids span {
		color: rgba(15, 29, 57, 0.84);
	}

	.reserva-option.junior {
		background: linear-gradient(135deg, #1736a8, #2a58ff);
	}

	.reserva-option.elite {
		background: linear-gradient(135deg, #d5141a, #ff2b27);
	}

	.reserva-option.defense {
		background: linear-gradient(135deg, #ff008c, #ff5bb6);
	}

	.schedule-contact-section {
		background: #0b0d12;
		color: #ffffff;
		padding: 0;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1fr 1fr 0.9fr 0.86fr;
		gap: 2.2rem;
		padding-top: 1.7rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		align-items: stretch;
	}

	.footer-brand p,
	.footer-social {
		max-width: 19rem;
	}

	.footer-brand,
	.footer-contact,
	.footer-feed,
	.footer-map-panel {
		position: relative;
		width: 100%;
		min-width: 0;
		height: 100%;
	}

	.footer-contact,
	.footer-feed,
	.footer-map-panel {
		padding-left: 1.5rem;
		border-left: 1px solid rgba(255, 255, 255, 0.12);
	}

	.footer-reviews {
		width: 100%;
		min-width: 0;
		justify-self: stretch;
	}

	.footer-social {
		display: flex;
		gap: 0.8rem;
		margin-top: 1.2rem;
		align-items: center;
	}

	.social-icon {
		width: 2.2rem;
		height: 2.2rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: #ffffff;
		background: transparent;
		opacity: 0.96;
		transition: transform 180ms ease, color 180ms ease, opacity 180ms ease;
	}

	.social-icon svg {
		width: 1.9rem;
		height: 1.9rem;
		fill: currentColor;
		stroke: none;
	}

	.social-icon:hover {
		color: #ff2d26;
		opacity: 1;
		transform: translateY(-2px);
	}

	.footer-contact,
	.footer-feed,
	.footer-map-panel {
		display: grid;
		justify-items: stretch;
		align-content: start;
		gap: 0.6rem;
	}

	.footer-contact h3,
	.footer-feed h3 {
		margin: 0 0 0.8rem;
		font-size: 1.15rem;
		font-weight: 900;
		text-transform: uppercase;
		color: #ffffff;
	}

	.footer-contact p {
		margin: 0;
	}

	.footer-contact p {
		font-size: 0.97rem;
		color: #d1d7e5;
		line-height: 1.6;
	}

	.contact-line {
		display: grid;
		grid-template-columns: 1.1rem 1fr;
		gap: 0.8rem;
		align-items: start;
	}

	.contact-icon {
		color: #ff2d26;
		line-height: 0;
		margin-top: 0.2rem;
	}

	.contact-icon svg {
		width: 1.05rem;
		height: 1.05rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.footer-map {
		position: relative;
		height: 100%;
		min-height: 0;
		margin-top: 0;
		border-radius: 0.55rem;
		border: 1px solid rgba(255, 255, 255, 0.08);
		overflow: hidden;
		background: #121722;
		flex: 1 1 auto;
	}

	.footer-map iframe {
		width: 100%;
		height: 100%;
		min-height: 0;
		border: 0;
		display: block;
		filter: grayscale(0.08) contrast(1.02) saturate(0.95);
	}

	.footer-brand {
		display: grid;
		align-content: start;
		gap: 0.75rem;
	}

	.footer-logo-image {
		width: min(100%, 17rem);
	}

	.footer-brand p {
		margin: 0.15rem 0 0;
		font-size: 0.9rem;
		color: #d1d7e5;
		line-height: 1.5;
	}

	.footer-feed p {
		margin: -0.3rem 0 0.2rem;
		font-size: 0.94rem;
		color: #d1d7e5;
	}

	.footer-map-panel h3 {
		margin: 0 0 0.8rem;
		font-size: 1.15rem;
		font-weight: 900;
		text-transform: uppercase;
		color: #ffffff;
	}

	.footer-map-copy {
		margin: -0.3rem 0 0.2rem;
		font-size: 0.94rem;
		color: #d1d7e5;
	}

	.footer-map-panel .button {
		min-height: 3.35rem;
		margin-top: auto;
	}

	.footer-action-button {
		width: min(100%, 16rem);
		align-self: center;
	}

	.footer-legal-bar {
		margin-top: 1.6rem;
		background: #141821;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	.footer-legal-copy {
		padding-top: 0.9rem;
		padding-bottom: 0.95rem;
	}

	.footer-legal-copy p {
		margin: 0;
		font-size: 0.72rem;
		line-height: 1.45;
		text-align: center;
		color: rgba(255, 255, 255, 0.68);
	}

	.map-card {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		padding: 1rem 1rem 1.1rem;
		width: 100%;
		min-width: 0;
		max-width: none;
		height: 13.8rem;
		border-radius: 0.9rem;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.02));
		border: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
		box-sizing: border-box;
		justify-self: stretch;
	}

	.reviews-card {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		padding: 1rem 1rem 1.1rem;
		width: 100%;
		min-width: 0;
		max-width: none;
		height: 13.8rem;
		border-radius: 0.9rem;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.02));
		border: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
		box-sizing: border-box;
		justify-self: stretch;
