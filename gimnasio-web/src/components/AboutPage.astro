const repairMojibake = <T,>(value: T): T => {
	if (typeof value === 'string') {
		return (value.includes('Ãƒ') || value.includes('Ã‚') || value.includes('Ã¢'))
			? (Buffer.from(value, 'latin1').toString('utf8') as T)
			: value;
	}

	if (Array.isArray(value)) {
		return value.map((item) => repairMojibake(item)) as T;
	}

	if (value && typeof value === 'object') {
		return Object.fromEntries(
			Object.entries(value).map(([key, item]) => [key, repairMojibake(item)])
		) as T;
	}

	return value;
};
const repairMojibakeDeep = <T,>(value: T): T => {
	if (typeof value === 'string') {
		let current = value;
		for (let index = 0; index < 3; index += 1) {
			if (!/[ÃƒÃ‚Ã¢Æ’]/.test(current)) break;
			current = Buffer.from(current, 'latin1').toString('utf8') as T & string;
		}
		return current as T;
	}

	if (Array.isArray(value)) {
		return value.map((item) => repairMojibakeDeep(item)) as T;
	}

	if (value && typeof value === 'object') {
		return Object.fromEntries(
			Object.entries(value).map(([key, item]) => [key, repairMojibakeDeep(item)])
		) as T;
	}

	return value;
};
