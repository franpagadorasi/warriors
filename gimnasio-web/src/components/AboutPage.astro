---
import Layout from '../layouts/Layout.astro';
import { getSiteCopy, type Locale } from '../lib/site-copy';
import { aboutPaths, getAboutPageCopy } from '../lib/about-copy';

interface Props {
	locale?: Locale;
}

const { locale = 'ca' } = Astro.props;
const copy = getSiteCopy(locale);
const aboutCopy = getAboutPageCopy(locale);

const homePaths: Record<Locale, string> = { ca: '/', es: '/es/', en: '/en/' };
const localeLabels: Record<Locale, string> = { ca: 'Català', es: 'Español', en: 'English' };
const languageAria: Record<Locale, string> = {
	ca: 'Idiomes disponibles',
	es: 'Idiomas disponibles',
	en: 'Available languages'
};
const closeModalLabel: Record<Locale, string> = {
	ca: 'Tancar',
	es: 'Cerrar',
	en: 'Close'
};
const sponsorsTitleLabel: Record<Locale, string> = {
	ca: 'PATROCINADORS',
	es: 'PATROCINADORES',
	en: 'SPONSORS'
};
const sponsorsAriaLabel: Record<Locale, string> = {
	ca: 'Patrocinadors',
	es: 'Patrocinadores',
	en: 'Sponsors'
};
const mapTitlePrefix: Record<Locale, string> = {
	ca: 'Mapa de',
	es: 'Mapa de',
	en: 'Map of'
};

const navLinks = {
	home: homePaths[locale],
	about: aboutPaths[locale],
	classes: `${homePaths[locale]}#clases`,
	pricing: `${homePaths[locale]}#cuotas`,
	schedule: `${homePaths[locale]}#horarios`,
	news: `${homePaths[locale]}#noticias`,
	gallery: `${homePaths[locale]}#galeria-destacada`,
	contact: '#contacto'
};

const localeSwitchPaths = {
	ca: aboutPaths.ca,
	es: aboutPaths.es,
	en: aboutPaths.en
};

const clubAddress = copy.footer.address;
const mapEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(clubAddress)}&output=embed`;
const mapDirectionsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(clubAddress)}`;
const googleReviewsUrl =
	'https://www.google.com/search?sa=X&sca_esv=72d5cd2ff8b49349&hl=es-ES&sxsrf=APpeQnteq4VAaMWerGiHchsD0iSncs0cfA:1786449416188&q=Club+Taekwondo+Warriors+Rese%C3%B1as&rflfq=1&num=20&stick=H4sIAAAAAAAAAONgkxIxNDMzMjA2NjSxMLUwMTayNDEwMdjAyPiKUcE5pzRJISQxNbs8Py8lXyE8sagoM7-oWCEotTj18MbE4kWsBJUAAHwBsRVhAAAA&rldimm=16620331485843294040&tbm=lcl&ved=2ahUKEwjSg_HWwpiWAxXtSfEDHV_pK2QQ9fQKegQIVRAG&biw=1920&bih=911&dpr=1#lkt=LocalPoiReviews';
const trialWhatsappUrl = `${copy.footer.whatsappUrl}?text=${copy.hero.trialWhatsappMessage}`;
const currentYear = new Date().getFullYear();
const scheduleGroupLogoByTone: Record<string, string> = {
	gold: '/images/warriors-kids.png',
	blue: '/images/warriors-junior.png',
	red: '/images/warriors-elite.png'
};
---

<Layout title={aboutCopy.seoTitle} description={aboutCopy.seoDescription} lang={copy.lang}>
	<header class="site-header">
		<div class="container header-row">
			<a class="brand" href={navLinks.home}>
				<img src="/images/logo-warriors-horizontal.png" alt="Club Taekwondo Warriors" class="brand-logo-full" />
			</a>

			<button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" data-menu-toggle>
				<span></span>
				<span></span>
				<span></span>
			</button>

			<nav class="nav" data-mobile-nav>
				<a href={navLinks.home}>{copy.nav.home}</a>
				<a class="active" href={navLinks.about}>{copy.nav.about}</a>
				<a href={navLinks.classes}>{copy.nav.classes}</a>
				<a href={navLinks.pricing}>{copy.nav.pricing}</a>
				<a href={navLinks.schedule}>{copy.nav.schedule}</a>
				<a href={navLinks.news}>{copy.nav.news}</a>
				<a href={navLinks.gallery}>{copy.nav.gallery}</a>
				<a href={navLinks.contact}>{copy.nav.contact}</a>
			</nav>

			<div class="header-languages" aria-label={languageAria[locale]}>
				<a class={`language-flag ${locale === 'ca' ? 'active' : ''}`} href={localeSwitchPaths.ca} aria-label="Català" title="Català"></a>
				<a class={`language-flag ${locale === 'es' ? 'active' : ''}`} href={localeSwitchPaths.es} aria-label="Español" title="Español"></a>
				<a class={`language-flag ${locale === 'en' ? 'active' : ''}`} href={localeSwitchPaths.en} aria-label="English" title="English"></a>
			</div>

			<div class="header-language-select">
				<label class="sr-only" for="mobile-language-select">{languageAria[locale]}</label>
				<select
					id="mobile-language-select"
					class="language-select"
					aria-label={languageAria[locale]}
					onchange="window.location.href=this.value"
				>
					<option value={localeSwitchPaths.ca} selected={locale === 'ca'}>Català</option>
					<option value={localeSwitchPaths.es} selected={locale === 'es'}>Español</option>
					<option value={localeSwitchPaths.en} selected={locale === 'en'}>English</option>
				</select>
			</div>

			<div class="mobile-language-menu" data-language-menu>
				<button
					class={`mobile-language-trigger flag-${locale}`}
					type="button"
					aria-label={languageAria[locale]}
					aria-expanded="false"
					data-language-toggle
				>
					<span class="mobile-language-flag" aria-hidden="true"></span>
					<span class="mobile-language-caret" aria-hidden="true"></span>
				</button>
				<div class="mobile-language-options" data-language-options>
					<a class={`mobile-language-option flag-ca ${locale === 'ca' ? 'active' : ''}`} href={localeSwitchPaths.ca} aria-label={localeLabels.ca} title={localeLabels.ca}>
						<span class="mobile-language-flag" aria-hidden="true"></span>
					</a>
					<a class={`mobile-language-option flag-es ${locale === 'es' ? 'active' : ''}`} href={localeSwitchPaths.es} aria-label={localeLabels.es} title={localeLabels.es}>
						<span class="mobile-language-flag" aria-hidden="true"></span>
					</a>
					<a class={`mobile-language-option flag-en ${locale === 'en' ? 'active' : ''}`} href={localeSwitchPaths.en} aria-label={localeLabels.en} title={localeLabels.en}>
						<span class="mobile-language-flag" aria-hidden="true"></span>
					</a>
				</div>
			</div>
		</div>
	</header>

	<main class="about-page-main">
		<section class="about-hero-page">
			<div class="container">
				<div class="section-title-line about-hero-title-line">
					<span></span>
					<h2 class="section-title center-title unified-title">{aboutCopy.hero.eyebrow}</h2>
					<span></span>
				</div>
			</div>
			<div class="container about-hero-shell">
				<div class="about-hero-copy">
					<h1>{aboutCopy.hero.title}</h1>
					{aboutCopy.hero.description.map((paragraph) => <p>{paragraph}</p>)}
					<div class="hero-page-actions">
						<button class="button button-primary" type="button" data-open-reserva-modal>
							{aboutCopy.hero.primaryCta}
						</button>
						<a class="button button-secondary" href="#contacto">{aboutCopy.hero.secondaryCta}</a>
					</div>
				</div>

				<div class="about-hero-media">
					<div class="about-hero-card logo-card">
						<img src="/images/about-logo-warriors.png" alt="Logo Club Taekwondo Warriors" />
					</div>
					<div class="about-hero-grid">
						<img src="/images/about-diana.jpeg" alt="Diana Vázquez Vallés" />
						<img src="/images/about-laia.jpeg" alt="Laia Marín" />
					</div>
				</div>
			</div>
		</section>

		<section class="about-story-section">
			<div class="container">
				<div class="section-title-line">
					<span></span>
					<h2 class="section-title center-title unified-title">{aboutCopy.story.title}</h2>
					<span></span>
				</div>
				<p class="section-intro">{aboutCopy.story.intro}</p>

				<div class="timeline-grid">
					{aboutCopy.story.timeline.map((item) => (
						<article class="timeline-card">
							<p class="timeline-year">{item.year}</p>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="logo-section">
			<div class="container">
				<div class="section-title-line">
					<span></span>
					<h2 class="section-title center-title unified-title">{aboutCopy.logo.title}</h2>
					<span></span>
				</div>
				<div class="logo-shell">
					<div class="logo-visual">
						<img src="/images/about-logo-warriors.png" alt="Símbolo Warriors" />
					</div>
					<div class="logo-copy">
						<p class="section-intro section-intro-left">{aboutCopy.logo.intro}</p>
						<ul class="logo-points">
							{aboutCopy.logo.points.map((point) => <li>{point}</li>)}
						</ul>
					</div>
				</div>
			</div>
		</section>

		<section class="team-section">
			<div class="container">
				<div class="section-title-line">
					<span></span>
					<h2 class="section-title center-title unified-title">{aboutCopy.team.title}</h2>
					<span></span>
				</div>
				<p class="section-intro">{aboutCopy.team.intro}</p>

				<div class="team-grid">
					{aboutCopy.team.members.map((member) => (
						<article class="team-card">
							<div class="team-image-wrap">
								<img src={member.image} alt={member.name} />
							</div>
							<div class="team-copy">
								<p class="team-role">{member.role}</p>
								<h3>{member.name}</h3>
								<p class="team-summary">{member.summary}</p>

								<div class="team-detail-block">
									<h4>{member.achievementsTitle}</h4>
									<ul>
										{member.achievements.map((item) => <li>{item}</li>)}
									</ul>
								</div>

								<div class="team-detail-block">
									<h4>{member.trainingTitle}</h4>
									<ul>
										{member.training.map((item) => <li>{item}</li>)}
									</ul>
								</div>

								<div class="team-detail-block">
									<h4>{member.philosophyTitle}</h4>
									<p>{member.philosophy}</p>
								</div>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="essence-section">
			<div class="container">
				<div class="section-title-line">
					<span></span>
					<h2 class="section-title center-title unified-title">{aboutCopy.clubEssence.title}</h2>
					<span></span>
				</div>

				<div class="essence-grid">
					<article class="essence-card">
						<h3>{aboutCopy.clubEssence.missionTitle}</h3>
						<p>{aboutCopy.clubEssence.mission}</p>
					</article>
					<article class="essence-card">
						<h3>{aboutCopy.clubEssence.visionTitle}</h3>
						<p>{aboutCopy.clubEssence.vision}</p>
					</article>
				</div>

				<div class="values-card">
					<h3>{aboutCopy.clubEssence.valuesTitle}</h3>
					<div class="values-list">
						{aboutCopy.clubEssence.values.map((value) => <span>{value}</span>)}
					</div>
					<p class="values-closing">{aboutCopy.clubEssence.closing}</p>
				</div>
			</div>
		</section>

		<section class="schedule-contact-section" id="contacto">
			<div class="container footer-grid">
				<div class="footer-brand">
					<div class="footer-logo">
						<img src="/images/logo-warriors-horizontal.png" alt="Club Taekwondo Warriors" class="footer-logo-image" />
					</div>

					<p>{copy.footer.description}</p>
					<div class="footer-social">
						<a href={copy.footer.instagramUrl || '#'} aria-label="Instagram" class="social-icon">
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M7.8 3h8.4A4.8 4.8 0 0 1 21 7.8v8.4a4.8 4.8 0 0 1-4.8 4.8H7.8A4.8 4.8 0 0 1 3 16.2V7.8A4.8 4.8 0 0 1 7.8 3zm8 1.8H8.2a3.4 3.4 0 0 0-3.4 3.4v7.6a3.4 3.4 0 0 0 3.4 3.4h7.6a3.4 3.4 0 0 0 3.4-3.4V8.2a3.4 3.4 0 0 0-3.4-3.4zM12 7.2A4.8 4.8 0 1 1 7.2 12 4.8 4.8 0 0 1 12 7.2zm0 1.7A3.1 3.1 0 1 0 15.1 12 3.1 3.1 0 0 0 12 8.9zm4.95-2.25a1.15 1.15 0 1 1-1.15 1.15 1.15 1.15 0 0 1 1.15-1.15z"></path>
							</svg>
						</a>
						<a href={copy.footer.whatsappUrl || '#'} aria-label="WhatsApp" class="social-icon">
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M12 2C6.48 2 2 6.35 2 11.72c0 1.9.57 3.67 1.54 5.16L2.5 22l5.34-1.4a10.2 10.2 0 0 0 4.16.88c5.52 0 10-4.35 10-9.72S17.52 2 12 2zm0 17.84a8.3 8.3 0 0 1-4.02-1.03l-.29-.16-3.17.83.84-3.06-.18-.31a8.02 8.02 0 0 1-1.15-4.09c0-4.46 3.62-8.08 8.07-8.08 2.15 0 4.17.83 5.69 2.34a8 8 0 0 1 2.36 5.74c0 4.46-3.62 8.08-8.08 8.08zm4.43-5.98c-.24-.12-1.42-.69-1.64-.76-.22-.08-.38-.12-.54.12-.16.23-.61.76-.75.92-.14.15-.28.17-.52.06-.24-.12-1.01-.37-1.92-1.18-.7-.63-1.18-1.42-1.31-1.66-.13-.23-.01-.36.1-.48.1-.1.24-.27.35-.4.12-.13.16-.23.24-.39.08-.16.04-.3-.02-.42-.06-.12-.54-1.28-.74-1.76-.2-.46-.4-.4-.54-.4h-.47c-.16 0-.42.06-.64.3-.22.23-.85.82-.85 2s.87 2.34.98 2.5c.12.15 1.7 2.56 4.12 3.6.58.25 1.03.4 1.38.51.58.18 1.1.16 1.51.09.46-.07 1.42-.58 1.62-1.12.2-.55.2-1.01.14-1.12-.06-.09-.21-.15-.45-.27z"></path>
							</svg>
						</a>
						<a href={`mailto:${copy.footer.email}`} aria-label="Email" class="social-icon">
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M2.5 6.75A2.25 2.25 0 0 1 4.75 4.5h14.5a2.25 2.25 0 0 1 2.25 2.25v10.5a2.25 2.25 0 0 1-2.25 2.25H4.75A2.25 2.25 0 0 1 2.5 17.25V6.75zm2.03-.75L12 11.32 19.47 6H4.53zm15.47 1.22-7.42 5.28a1 1 0 0 1-1.16 0L4 7.22v10.03c0 .41.34.75.75.75h14.5c.41 0 .75-.34.75-.75V7.22z"></path>
							</svg>
						</a>
					</div>
					<div class="footer-sponsors-row">
						<p class="footer-sponsors-title">{sponsorsTitleLabel[locale]}</p>
						<div class="footer-sponsors" aria-label={sponsorsAriaLabel[locale]}>
							<a href="https://www.svh.cat/" target="_blank" rel="noreferrer" class="sponsor-badge" aria-label="Ajuntament de Sant Vicenç dels Horts">
								<img src="/images/patrocinadores/Ajuntament-de-Sant-Vicenç-dels-Horts-transparent.png" alt="Ajuntament de Sant Vicenç dels Horts" class="sponsor-badge-image sponsor-badge-image-wide" />
							</a>
							<a href="https://www.taekwondocatala.com/" target="_blank" rel="noreferrer" class="sponsor-badge" aria-label="Federació Catalana de Taekwondo">
								<img src="/images/patrocinadores/Federación-Catalana-de-Taekwondo-transparent.png" alt="Federació Catalana de Taekwondo" class="sponsor-badge-image" />
							</a>
							<a href="https://fetaekwondo.net/" target="_blank" rel="noreferrer" class="sponsor-badge" aria-label="Federación Española de Taekwondo">
								<img src="/images/patrocinadores/Federación-Española-de-Taekwondo-transparent.png" alt="Federación Española de Taekwondo" class="sponsor-badge-image" />
							</a>
						</div>
					</div>
				</div>

				<div class="footer-contact">
					<h3>{copy.footer.contactTitle}</h3>
					<div class="contact-line">
						<span class="contact-icon">
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M12 21s-6-5.6-6-11a6 6 0 1 1 12 0c0 5.4-6 11-6 11z"></path>
								<circle cx="12" cy="10" r="2.4"></circle>
							</svg>
						</span>
						<p>{clubAddress}</p>
					</div>
					<div class="contact-line">
						<span class="contact-icon">
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M5 4h3l1.2 4.2-1.6 1.6a15.4 15.4 0 0 0 6.6 6.6l1.6-1.6L20 16v3a2 2 0 0 1-2.2 2A17 17 0 0 1 3 5.2 2 2 0 0 1 5 4z"></path>
							</svg>
						</span>
						<p>{copy.footer.phone}</p>
					</div>
					<div class="contact-line">
						<span class="contact-icon">
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<rect x="3" y="5" width="18" height="14" rx="2"></rect>
								<path d="M4 7l8 6 8-6"></path>
							</svg>
						</span>
						<p>{copy.footer.email}</p>
					</div>
					<div class="contact-line">
						<span class="contact-icon">
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<circle cx="12" cy="12" r="8"></circle>
								<path d="M12 7v5l3 2"></path>
							</svg>
						</span>
						<p>{copy.footer.hours}</p>
					</div>
				</div>

				<div class="footer-feed footer-reviews">
					<h3>{copy.footer.reviewsTitle}</h3>
					<p>{copy.footer.reviewsSubtitle}</p>
					<div class="reviews-card">
						<div class="reviews-card-top">
							<div class="reviews-google-mark" aria-hidden="true">G</div>
							<div class="reviews-rating-copy">
								<strong>{copy.footer.reviewsRatingLabel}</strong>
								<span>{copy.footer.reviewsCountLabel}</span>
							</div>
						</div>
						<div class="reviews-stars" aria-label={copy.footer.reviewsRatingLabel}>
							<span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
						</div>
						<a class="reviews-button" href={googleReviewsUrl} target="_blank" rel="noreferrer">
							{copy.footer.reviewsButton}
						</a>
					</div>
				</div>

				<div class="footer-map-panel">
					<h3>{copy.footer.mapTitle}</h3>
					<p class="footer-map-copy">{copy.footer.mapSubtitle}</p>
					<div class="map-card">
						<div class="footer-map">
							<iframe
								src={mapEmbedUrl}
								title={`${mapTitlePrefix[locale]} ${clubAddress}`}
								loading="lazy"
								referrerpolicy="no-referrer-when-downgrade"
							></iframe>
						</div>
						<a class="button button-primary full" href={mapDirectionsUrl} target="_blank" rel="noreferrer">
							{copy.footer.mapButton}
						</a>
					</div>
				</div>
			</div>
			<div class="footer-legal-bar">
				<div class="container footer-legal-copy">
					<p>© {currentYear} Francisco J. Pagador. {copy.footer.legal}</p>
				</div>
			</div>
		</section>
	</main>

	<div class="reserva-overlay" data-reserva-overlay hidden>
		<div class="modal-backdrop" data-close-reserva-modal></div>
		<div class="reserva-modal" role="dialog" aria-modal="true" aria-labelledby="reserva-modal-title">
			<button class="reserva-modal-close" type="button" aria-label={closeModalLabel[locale]} data-close-reserva-modal>&times;</button>
			<p class="reserva-modal-kicker">{copy.modal.kicker}</p>
			<h2 id="reserva-modal-title">{copy.modal.title}</h2>
			<p class="reserva-modal-copy">{copy.modal.description}</p>
			<div class="reserva-options">
				{copy.modal.options.map((option) => (
					<a class={`reserva-option ${option.tone}`} href={option.url} target="_blank" rel="noreferrer">
						<img class="reserva-option-logo" src={scheduleGroupLogoByTone[option.tone === 'kids' ? 'gold' : option.tone === 'junior' ? 'blue' : 'red']} alt={option.title} />
						<div class="reserva-option-copy">
							<span>{option.subtitle}</span>
						</div>
					</a>
				))}
			</div>
		</div>
	</div>

	<script is:inline>
		(() => {
			document.body.style.overflow = '';

			const initMobileMenu = () => {
				const header = document.querySelector('.site-header');
				const toggle = document.querySelector('[data-menu-toggle]');
				const nav = document.querySelector('[data-mobile-nav]');
				if (!(header instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;

				const closeMenu = () => {
					header.classList.remove('menu-open');
					header.classList.remove('language-open');
					toggle.setAttribute('aria-expanded', 'false');
					document.body.style.overflow = '';
				};

				const openMenu = () => {
					header.classList.add('menu-open');
					toggle.setAttribute('aria-expanded', 'true');
					document.body.style.overflow = 'hidden';
				};

				toggle.addEventListener('click', () => {
					if (header.classList.contains('menu-open')) {
						closeMenu();
					} else {
						openMenu();
					}
				});

				nav.querySelectorAll('a').forEach((link) => {
					link.addEventListener('click', closeMenu);
				});

				window.addEventListener('resize', () => {
					if (window.innerWidth > 760) closeMenu();
				});

				const languageToggle = document.querySelector('[data-language-toggle]');
				const languageOptions = document.querySelector('[data-language-options]');

				if (languageToggle instanceof HTMLButtonElement && languageOptions instanceof HTMLElement) {
					const closeLanguageMenu = () => {
						header.classList.remove('language-open');
						languageToggle.setAttribute('aria-expanded', 'false');
					};

					const openLanguageMenu = () => {
						header.classList.add('language-open');
						languageToggle.setAttribute('aria-expanded', 'true');
					};

					languageToggle.addEventListener('click', (event) => {
						event.stopPropagation();
						if (header.classList.contains('language-open')) {
							closeLanguageMenu();
						} else {
							openLanguageMenu();
						}
					});

					languageOptions.querySelectorAll('a').forEach((link) => {
						link.addEventListener('click', closeLanguageMenu);
					});

					document.addEventListener('click', (event) => {
						const target = event.target;
						if (!(target instanceof Node)) return;
						if (!languageOptions.contains(target) && !languageToggle.contains(target)) {
							closeLanguageMenu();
						}
					});
				}
			};

			const initReservaModal = () => {
				const overlay = document.querySelector('[data-reserva-overlay]');
				const openButtons = document.querySelectorAll('[data-open-reserva-modal]');
				const closeButtons = document.querySelectorAll('[data-close-reserva-modal]');
				if (!(overlay instanceof HTMLElement)) return;

				const openModal = () => {
					overlay.hidden = false;
					document.body.style.overflow = 'hidden';
				};
				const closeModal = () => {
					overlay.hidden = true;
					document.body.style.overflow = '';
				};

				openButtons.forEach((button) => button.addEventListener('click', openModal));
				closeButtons.forEach((button) => button.addEventListener('click', closeModal));
				document.addEventListener('keydown', (event) => {
					if (event.key === 'Escape' && !overlay.hidden) closeModal();
				});
			};

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', () => {
					initMobileMenu();
					initReservaModal();
				}, { once: true });
			} else {
				initMobileMenu();
				initReservaModal();
			}
		})();
	</script>
</Layout>

