---
import { buildSportsClubSchema, DEFAULT_OG_IMAGE, OG_LOCALE_BY_LANG, SITE_NAME, toAbsoluteUrl } from '../lib/seo';
import type { Locale } from '../lib/site-copy';

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	path?: string;
	ogImage?: string;
	alternates?: Array<{ lang: string; path: string }>;
	structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
	title = 'Escuela de Taekwondo',
	description = 'Web informativa para una escuela de taekwondo con inscripcion a clase de prueba y contacto directo.',
	lang = 'ca',
	path = '/',
	ogImage = DEFAULT_OG_IMAGE,
	alternates = [],
	structuredData
} = Astro.props;

const locale = (lang in OG_LOCALE_BY_LANG ? lang : 'ca') as Locale;
const canonicalUrl = toAbsoluteUrl(path);
const ogImageUrl = toAbsoluteUrl(ogImage);
const seoSchema = structuredData ?? buildSportsClubSchema({
	locale,
	description,
	canonicalPath: path,
	imagePath: ogImage
});
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/png" sizes="512x512" href="/images/logo-warriors.png" />
		<link rel="apple-touch-icon" href="/images/logo-warriors.png" />
		<link rel="canonical" href={canonicalUrl} />
		{alternates.map((alternate) => (
			<link rel="alternate" hreflang={alternate.lang} href={toAbsoluteUrl(alternate.path)} />
		))}
		<link rel="alternate" hreflang="x-default" href={toAbsoluteUrl('/')} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content="index,follow" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={OG_LOCALE_BY_LANG[locale]} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content={title} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="theme-color" content="#05070d" />
		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(seoSchema)}></script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg: #05070d;
		--text: #f5f7fb;
		--muted: #aab3c5;
		--primary: #e31d1c;
		--secondary: #1762ff;
		--accent: #ffd24a;
		--max-width: 1520px;
	}

	* {
		box-sizing: border-box;
	}

	html {
		width: 100%;
		scroll-behavior: smooth;
		overflow-x: hidden;
	}

	body {
		margin: 0;
		width: 100%;
		min-width: 320px;
		font-family: 'Oswald', Arial, Helvetica, sans-serif;
		color: var(--text);
		background: var(--bg);
		letter-spacing: 0.01em;
		overflow-x: hidden;
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6,
	.nav a,
	.button,
	.section-kicker,
	.section-head a {
		font-family: 'Oswald', Arial, sans-serif;
		letter-spacing: 0.02em;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	img {
		max-width: 100%;
		display: block;
	}

	.container {
		width: min(var(--max-width), calc(100% - 1rem));
		margin: 0 auto;
	}

	.section-title {
		margin: 0 0 0.8rem;
		font-size: clamp(2rem, 4vw, 3.35rem);
		line-height: 0.92;
		text-transform: uppercase;
		letter-spacing: 0.02em;
	}

	.section-copy {
		margin: 0;
		font-size: 1.02rem;
		line-height: 1.55;
		color: #4f596d;
	}
</style>
