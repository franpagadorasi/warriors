		border: 2px solid rgba(255, 255, 255, 0.88);
	}

	.value-pill-icon svg {
		width: 1.85rem;
		height: 1.85rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.9;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.value-pill.blue .value-pill-icon,
	.value-pill.red .value-pill-icon {
		color: #1736a8;
	}

	.value-pill.red .value-pill-icon {
		color: #d5141a;
	}

	.value-pill.gold .value-pill-icon {
		color: #c98600;
	}

	.value-pill-text {
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
