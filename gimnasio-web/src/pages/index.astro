	}

	.schedule-time.blue {
		color: #174eff;
	}

	.schedule-time.red {
		color: #e31d1c;
	}

	.schedule-time strong {
		font-size: 1.6rem;
		font-weight: 900;
		letter-spacing: -0.02em;
	}

	.schedule-time-icon {
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 999px;
		border: 3px solid currentColor;
		position: relative;
		opacity: 0.95;
	}

	.schedule-time-icon::before,
	.schedule-time-icon::after {
		content: '';
		position: absolute;
		left: 50%;
		top: 50%;
		background: currentColor;
		border-radius: 999px;
		transform-origin: left center;
	}

	.schedule-time-icon::before {
		width: 0.55rem;
		height: 0.16rem;
		transform: translate(-5%, -50%) rotate(0deg);
	}

	.schedule-time-icon::after {
		width: 0.42rem;
		height: 0.16rem;
		transform: translate(-5%, -50%) rotate(90deg);
	}

	.schedule-cell {
		color: #fff;
		font-weight: 900;
		text-transform: uppercase;
		position: relative;
		overflow: hidden;
	}

	.schedule-cell span {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		line-height: 0.9;
		text-shadow: 0 3px 10px rgba(0, 0, 0, 0.24);
	}

	.schedule-cell span small {
		font-size: 1.45rem;
		font-weight: 900;
		letter-spacing: 0.04em;
	}

	.schedule-cell span strong {
		font-size: 2.1rem;
		font-weight: 900;
		letter-spacing: -0.03em;
	}

	.schedule-cell::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at 50% 35%, rgba(255, 255, 255, 0.18), transparent 35%),
			linear-gradient(135deg, rgba(255, 255, 255, 0.12), transparent 42%);
		opacity: 0.9;
	}

	.schedule-cell::after {
		content: '';
		position: absolute;
		left: 18%;
		right: 18%;
		bottom: 26%;
		height: 0.9rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.12);
		filter: blur(8px);
	}

	.schedule-cell.gold {
		background:
			radial-gradient(circle at 50% 20%, rgba(255, 234, 162, 0.45), transparent 30%),
			linear-gradient(180deg, #f4b000 0%, #ffc827 48%, #f0ad00 100%);
		color: #fff;
	}

	.schedule-cell.blue {
		background:
			radial-gradient(circle at 50% 20%, rgba(157, 187, 255, 0.22), transparent 28%),
			linear-gradient(180deg, #1736a8 0%, #1c45d6 55%, #214fff 100%);
	}

	.schedule-cell.red {
		background:
			radial-gradient(circle at 50% 20%, rgba(255, 173, 173, 0.18), transparent 28%),
			linear-gradient(180deg, #d5141a 0%, #ef1e1b 58%, #ff2823 100%);
	}

	.schedule-cell.empty {
		background: #ffffff;
	}

	.schedule-cell.empty::before,
	.schedule-cell.empty::after {
		display: none;
	}

	.schedule-notes {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 1.05rem;
		margin-top: 1.15rem;
	}

	.age-box,
	.values-box {
		background: #f5f5f5;
		border-radius: 1.5rem;
		padding: 1.25rem 1.35rem;
		border: 1px solid rgba(17, 23, 35, 0.08);
		box-shadow: 0 16px 32px rgba(15, 18, 28, 0.07);
	}

	.age-line {
		display: grid;
		grid-template-columns: 4rem 1fr;
		align-items: center;
		gap: 1rem;
		margin: 0;
		padding: 0.95rem 0.95rem 0.95rem 0.7rem;
		border-bottom: 1px solid rgba(17, 23, 35, 0.08);
		border-radius: 1rem;
		background: #f5f5f5;
	}

	.age-line:last-child {
		border-bottom: 0;
	}

	.age-swatch {
		width: 3rem;
		height: 0.9rem;
		border-radius: 999px;
		position: relative;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4);
	}

	.age-swatch::before {
		content: '';
		position: absolute;
		inset: -0.22rem -0.15rem;
		border-radius: 999px;
		opacity: 0.2;
		filter: blur(6px);
	}

	.age-line.gold .age-swatch {
		background: linear-gradient(90deg, #e7a708, #ffc928);
	}

	.age-line.gold .age-swatch::before {
		background: #f0b411;
	}

	.age-line.blue .age-swatch {
		background: linear-gradient(90deg, #1736a8, #2a58ff);
	}

	.age-line.blue .age-swatch::before {
		background: #214fff;
	}

	.age-line.red .age-swatch {
		background: linear-gradient(90deg, #d5141a, #ff2b27);
	}

	.age-line.red .age-swatch::before {
		background: #eb241f;
	}

	.age-copy {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.55rem 0.9rem;
	}

	.age-line strong {
		font-size: 1.3rem;
		text-transform: uppercase;
		letter-spacing: -0.02em;
		color: #0f1d39;
	}

	.age-line span {
		color: #3f5478;
		font-weight: 800;
		font-size: 1.03rem;
	}

	.age-line.gold strong {
		color: #cf8c00;
	}

	.age-line.blue strong {
		color: #1736a8;
	}

	.age-line.red strong {
		color: #d5141a;
	}

	.values-box {
		display: grid;
		gap: 0.85rem;
	}

	.value-pill {
		position: relative;
		display: grid;
		grid-template-columns: 4.3rem 1fr;
		align-items: center;
		gap: 0.95rem;
		min-height: 4.25rem;
		padding: 0 1.1rem 0 0.3rem;
		color: #fff;
		font-size: 1.12rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		overflow: hidden;
	}

	.value-pill::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 1rem;
		clip-path: polygon(2% 25%, 12% 18%, 25% 12%, 40% 16%, 58% 8%, 73% 14%, 88% 10%, 98% 18%, 96% 80%, 82% 88%, 66% 84%, 45% 92%, 27% 86%, 11% 90%, 3% 77%);
	}

	.value-pill::after {
		content: '';
		position: absolute;
		left: 4.9rem;
		right: 0.9rem;
		top: 50%;
		height: 1.7rem;
		transform: translateY(-50%);
		background: rgba(255, 255, 255, 0.08);
		filter: blur(10px);
		opacity: 0.55;
	}

	.value-pill.blue {
		background: transparent;
	}

	.value-pill.blue::before {
		background:
			radial-gradient(circle at 20% 50%, rgba(255, 255, 255, 0.16), transparent 26%),
			linear-gradient(90deg, #1736a8 0%, #2248d8 55%, #2e57ff 100%);
	}

	.value-pill.red {
		background: transparent;
	}

	.value-pill.red::before {
		background:
			radial-gradient(circle at 20% 50%, rgba(255, 255, 255, 0.14), transparent 24%),
			linear-gradient(90deg, #cb1418 0%, #e21b1e 54%, #ff2b27 100%);
	}

	.value-pill.gold {
		background: transparent;
		color: #10245f;
	}

	.value-pill.gold::before {
		background:
			radial-gradient(circle at 20% 50%, rgba(255, 255, 255, 0.2), transparent 24%),
			linear-gradient(90deg, #e9a90b 0%, #f3ba16 52%, #ffd145 100%);
	}

	.value-pill-icon,
	.value-pill-text {
		position: relative;
		z-index: 2;
	}

	.value-pill-icon {
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 999px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.92);
		box-shadow:
			0 10px 18px rgba(0, 0, 0, 0.14),
