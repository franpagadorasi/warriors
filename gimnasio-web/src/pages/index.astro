---
import Layout from '../layouts/Layout.astro';
import { getHomeContent } from '../lib/content';

const content = await getHomeContent();

const formatNewsDate = (date: string) => {
	const parsed = new Date(date);
	if (Number.isNaN(parsed.getTime())) return date;
	const months = ['ENE', 'FEB', 'MAR', 'ABR', 'MAY', 'JUN', 'JUL', 'AGO', 'SEP', 'OCT', 'NOV', 'DIC'];
	return `${String(parsed.getUTCDate()).padStart(2, '0')} ${months[parsed.getUTCMonth()]} ${parsed.getUTCFullYear()}`;
};

const galleryItems = [...content.gallery].sort((a, b) => Number(b.featured) - Number(a.featured) || (a.order ?? 99) - (b.order ?? 99));

const pricingPlans = [
	{
		tone: 'gold',
		name: 'Cuota amarilla',
		subtitle: 'Iniciacion',
		price: '25EUR',
		frequency: '/mes',
		items: [
			'1 dia por semana',
			'Ideal para empezar y descubrir el taekwondo',
			'Aprendizaje de tecnicas basicas',
			'Desarrollo de coordinacion, disciplina y valores'
		]
	},
	{
		tone: 'blue',
		name: 'Cuota azul elite',
		subtitle: 'Progresion',
		price: '45EUR',
		frequency: '/mes',
		badge: 'Recomendada',
		items: [
			'2 dias por semana',
			'Mayor continuidad y evolucion tecnica',
			'Preparacion para examenes de grado',
			'Mejora fisica y deportiva'
		]
	},
	{
		tone: 'red',
		name: 'Cuota roja elite',
		subtitle: 'Competicion',
		price: '55EUR',
		frequency: '/mes',
		items: [
			'3 dias por semana',
			'Para ninos que se inician en la competicion',
			'Perfeccionamiento tecnico y tactico',
			'Mejora fisica y rendimiento'
		]
	}
];

const clubReasons = [
	'Taekwondo olimpico',
	'Profesores titulados',
	'Examenes de grado',
	'Participacion en exhibiciones',
	'Equipo de competicion',
	'Ambiente familiar y educativo'
];
---

<Layout title={`${content.settings.businessName} | Taekwondo olimpico`} description={content.settings.heroDescription}>
	<header class="site-header">
		<div class="container header-row">
			<a class="brand" href="#inicio">
				<div class="brand-mark">
					<span>CT</span>
				</div>

				<div class="brand-copy">
					<strong>{content.settings.businessName}</strong>
					<span>{content.settings.tagline}</span>
				</div>
			</a>

			<nav class="nav">
				<a class="active" href="#inicio">Inicio</a>
				<a href="#club">El club</a>
				<a href="#clases">Modalidades</a>
				<a href="#horarios">Horarios</a>
				<a href="#noticias">Noticias</a>
				<a href="#galeria">Galeria</a>
				<a href="#contacto">Contacto</a>
			</nav>

		</div>
	</header>

	<main>
		<section class="hero" id="inicio">
			<div class="container hero-shell">
				<div class="hero-copy">
					<p class="hero-kicker">{content.settings.eyebrow}</p>
					<h1>
						{content.settings.heroTitle.split('. ')[0] + '.'}
						<span>{content.settings.heroTitle.split('. ').slice(1).join('. ') || content.settings.tagline}</span>
					</h1>
					<p class="hero-text">{content.settings.heroDescription}</p>

					<div class="hero-actions">
						<a class="button button-secondary" href={content.settings.secondaryCtaUrl || '#club'}>
							{content.settings.secondaryCtaLabel || 'Conocenos'}
						</a>
					</div>
				</div>

				<div class="hero-media">
					<img src={content.settings.heroImageUrl || '/images/hero-taekwondo.png'} alt="Combate de taekwondo olimpico" />
				</div>
			</div>

			<div class="container feature-band">
				{content.features.map((item) => (
					<article class={`feature-card ${item.tone ?? 'red'}`}>
						<div class="feature-icon"></div>
						<div>
							<h2>{item.title}</h2>
							<p>{item.description}</p>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="about-section" id="club">
			<div class="container about-shell">
				<div class="about-copy">
					<p class="section-kicker">{content.settings.aboutKicker}</p>
					<div class="section-underline"></div>
					<h2 class="section-title">{content.settings.aboutTitle}</h2>
					<p class="section-copy">{content.settings.aboutDescription}</p>
					<a class="button button-blue" href={content.settings.aboutCtaUrl || '#contacto'}>
						{content.settings.aboutCtaLabel || 'Conoce nuestra historia'}
					</a>
				</div>

				<div class="about-gallery" id="galeria">
					<img class="about-main" src={content.settings.aboutImageMainUrl || '/images/dojo-interior.png'} alt="Instalaciones del club" />
					<img src={content.settings.aboutImageSecondaryOneUrl || '/images/kids-taekwondo.png'} alt="Clase infantil" />
					<img src={content.settings.aboutImageSecondaryTwoUrl || '/images/modalidad-exhibicion.png'} alt="Exhibicion de taekwondo" />
					<img src={content.settings.aboutImageSecondaryThreeUrl || '/images/modalidad-combate.png'} alt="Entrenamiento de combate" />
				</div>
			</div>
		</section>

		<section class="classes-section" id="clases">
			<div class="container">
				<p class="section-kicker center">{content.settings.classesKicker}</p>
				<h2 class="section-title center-title">{content.settings.classesTitle}</h2>

				<div class="class-grid">
					{content.classes.map((item) => (
						<article class="class-card">
							<div class="class-thumb">
								<img src={item.imageUrl || '/images/modalidad-combate.png'} alt={item.title} />
							</div>

							<div class="class-copy">
								<h3>{item.title}</h3>
								<p>{item.description}</p>

								<div class="class-meta">
									<span>{item.audience ?? 'Todos los niveles'}</span>
									<a href="#contacto">Mas informacion</a>
								</div>
							</div>
						</article>
					))}
				</div>

				<div class="section-actions">
					<a class="button button-outline-dark" href="#contacto">{content.settings.classesButtonLabel}</a>
				</div>
			</div>
		</section>

		<section class="pricing-section" id="cuotas">
			<div class="container">
				<p class="section-kicker center">Cuotas de entrenamiento</p>
				<h2 class="section-title center-title pricing-title">Planes y progresion</h2>

				<div class="pricing-grid">
					{pricingPlans.map((plan) => (
						<article class={`pricing-card ${plan.tone}`}>
							{plan.badge && <span class="pricing-badge">{plan.badge}</span>}
							<div class="pricing-head">
								<h3>{plan.name}</h3>
								<p>{plan.subtitle}</p>
							</div>

							<ul class="pricing-list">
								{plan.items.map((item) => <li>{item}</li>)}
							</ul>

							<div class="pricing-price">
								<strong>{plan.price}</strong>
								<span>{plan.frequency}</span>
							</div>
						</article>
					))}
				</div>

				<div class="reasons-row">
					<p class="reasons-title">Por que entrenar en Warriors?</p>
					<div class="reasons-grid">
						{clubReasons.map((reason) => <span>{reason}</span>)}
					</div>
				</div>
			</div>
		</section>

		<section class="stats-band">
			<div class="container stats-grid">
				{content.stats.map((item) => (
					<div class={`stat-card ${item.tone ?? 'red'}`}>
						<strong>{item.value}</strong>
						<span>{item.label}</span>
					</div>
				))}
			</div>
		</section>

		<section class="updates-section">
			<div class="container updates-grid">
				<div class="news-panel" id="noticias">
					<div class="section-head">
						<h2>{content.settings.newsTitle}</h2>
						<a href="#contacto">{content.settings.newsLinkLabel}</a>
					</div>

					<div class="news-grid">
						{content.news.map((item) => (
							<article class="news-card">
								<img src={item.imageUrl || '/images/modalidad-combate.png'} alt={item.title} />
								<div class="news-copy">
									<span>{formatNewsDate(item.date)}</span>
									<h3>{item.title}</h3>
									<a href="#contacto">{item.ctaLabel || 'Leer mas'}</a>
								</div>
							</article>
						))}
					</div>
				</div>

				<div class="gallery-panel">
					<div class="section-head">
						<h2>{content.settings.galleryTitle}</h2>
						<a href="#contacto">{content.settings.galleryLinkLabel}</a>
					</div>

					<div class="gallery-grid">
						{galleryItems.map((item, index) => (
							<div class={`gallery-card gallery-${index + 1}`}>
								<img src={item.imageUrl || '/images/dojo-interior.png'} alt={item.title} />
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="cta-banner">
			<div class="container cta-shell">
				<div class="cta-image">
					<img src={content.settings.ctaImageUrl || '/images/modalidad-poomsae.png'} alt="Practica de taekwondo" />
				</div>

				<div class="cta-copy">
					<h2>{content.settings.ctaTitle}</h2>
					<p>{content.settings.ctaDescription}</p>
				</div>

				<a class="button button-primary cta-button" href={content.settings.whatsappUrl} target="_blank" rel="noreferrer">
					{content.settings.ctaButtonLabel}
				</a>
			</div>
		</section>

		<section class="schedule-contact-section" id="horarios">
			<div class="container footer-grid">
				<div class="footer-brand">
					<div class="footer-logo">
						<div class="brand-mark small">
							<span>CT</span>
						</div>
						<div class="brand-copy">
							<strong>{content.settings.businessName}</strong>
							<span>{content.settings.tagline}</span>
						</div>
					</div>

					<p>{content.settings.footerDescription}</p>
					<div class="footer-social">
						<a href={content.settings.instagramUrl || '#'} aria-label="Instagram" class="social-icon">
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<rect x="4" y="4" width="16" height="16" rx="4"></rect>
								<circle cx="12" cy="12" r="3.5"></circle>
								<circle cx="17.2" cy="6.8" r="1"></circle>
							</svg>
						</a>
						<a href={content.settings.facebookUrl || '#'} aria-label="Facebook" class="social-icon">
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M13.5 20v-6h2.5l.4-3h-2.9V9.2c0-.9.3-1.5 1.6-1.5H16.5V5.1c-.3 0-1.1-.1-2.1-.1-2.1 0-3.5 1.3-3.5 3.7V11H8.5v3h2.4v6z"></path>
							</svg>
						</a>
						<a href={content.settings.tiktokUrl || '#'} aria-label="TikTok" class="social-icon">
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M14.6 4c.4 1.1 1.3 2 2.4 2.5.8.4 1.7.6 2.5.6v2.7c-1 0-2-.2-2.9-.6v5.2c0 2.7-2.2 4.8-4.8 4.8S7 17.1 7 14.4s2.2-4.8 4.8-4.8c.3 0 .6 0 .9.1v2.8a2.2 2.2 0 0 0-.9-.2 2.1 2.1 0 1 0 2.1 2.1V4z"></path>
							</svg>
						</a>
					</div>
				</div>

				<div class="footer-links">
					<h3>Enlaces rapidos</h3>
					<a href="#club">El club</a>
					<a href="#clases">Modalidades</a>
					<a href="#horarios">Horarios</a>
					<a href="#noticias">Noticias</a>
					<a href="#contacto">Contacto</a>
				</div>

				<div class="footer-schedule">
					<h3>Horarios</h3>
					{content.schedule.map((item) => (
						<p><strong>{item.group}</strong><span>{item.days} · {item.time}</span></p>
					))}
				</div>

				<div class="footer-contact" id="contacto">
					<h3>Contacto</h3>
					<p>{content.settings.address}</p>
					<p>{content.settings.phone}</p>
					<p>{content.settings.email}</p>
					<div class="footer-map"></div>
					<a class="button button-primary full" href={content.settings.whatsappUrl} target="_blank" rel="noreferrer">
						{content.settings.mapButtonLabel}
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgba(3, 4, 9, 0.96);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		backdrop-filter: blur(16px);
	}

	.header-row {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 1.25rem;
		min-height: 4.8rem;
	}

	.brand,
	.footer-logo {
		display: flex;
		align-items: center;
		gap: 0.9rem;
	}

	.brand-mark {
		width: 4.4rem;
		height: 4.4rem;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: conic-gradient(from 180deg, #ff2a23, #ffbf2c, #1e67ff, #ff2a23);
		box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.07);
	}

	.brand-mark.small {
		width: 3.3rem;
		height: 3.3rem;
	}

	.brand-mark span {
		font-size: 1.4rem;
		font-weight: 900;
		color: #fff;
	}

	.brand-copy strong,
	.brand-copy span {
		display: block;
	}

	.brand-copy strong {
		font-size: 1rem;
		line-height: 1.05;
	}

	.brand-copy span {
		margin-top: 0.3rem;
		font-size: 0.82rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.nav {
		display: flex;
		justify-content: center;
		gap: 1.55rem;
		font-size: 0.74rem;
		font-weight: 900;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.nav a {
		position: relative;
		padding: 1.4rem 0;
	}

	.nav a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0.7rem;
		height: 0.18rem;
		background: #ff2a23;
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 160ms ease;
	}

	.nav a.active::after,
	.nav a:hover::after {
		transform: scaleX(1);
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 0.8rem;
		padding: 0.9rem 1.25rem;
		font-size: 0.95rem;
		font-weight: 900;
		text-transform: uppercase;
		transition: transform 160ms ease, filter 160ms ease;
	}

	.button-primary {
		background: linear-gradient(135deg, #d51319, #ff3328);
		color: #fff;
	}

	.button-secondary {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.14);
		color: #fff;
	}

	.button-blue {
		background: #174eff;
		color: #fff;
	}

	.button-outline-dark {
		background: transparent;
		border: 1px solid rgba(17, 23, 35, 0.24);
		color: #111827;
	}

	.full {
		width: 100%;
	}

	.button:hover {
		transform: translateY(-2px);
		filter: brightness(1.04);
	}

	.hero {
		background: #03050b;
		padding-bottom: 0;
	}

	.hero-shell {
		display: grid;
		grid-template-columns: 0.92fr 1.08fr;
		align-items: stretch;
		background: #05070d;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-top: 0;
	}

	.hero-copy {
		padding: 2.2rem 2rem 2rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.hero-kicker,
	.section-kicker {
		margin: 0 0 1rem;
		color: #ffbf2c;
		font-size: 0.82rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.18em;
	}

	.hero-copy h1 {
		margin: 0;
		max-width: 8ch;
		font-size: clamp(3.2rem, 6.1vw, 5.85rem);
		line-height: 0.92;
		text-transform: uppercase;
		font-weight: 900;
	}

	.hero-copy h1 span {
		display: block;
		color: #ff241f;
	}

	.hero-text {
		max-width: 31ch;
		margin: 1.15rem 0 0;
		font-size: 1.1rem;
		line-height: 1.6;
		color: #d6dfef;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		margin-top: 1.7rem;
	}

	.hero-media {
		min-height: 31rem;
	}

	.hero-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.feature-band {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		background: #111214;
		border-left: 1px solid rgba(255, 255, 255, 0.08);
		border-right: 1px solid rgba(255, 255, 255, 0.08);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.feature-card {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 1rem;
		padding: 1.25rem 1.4rem;
		border-right: 1px solid rgba(255, 255, 255, 0.08);
	}

	.feature-card:last-child {
		border-right: 0;
	}

	.feature-icon {
		width: 1.2rem;
		height: 1.2rem;
		margin-top: 0.2rem;
		border-radius: 0.2rem;
		background: currentColor;
	}

	.feature-card.red {
		color: #ff2d26;
	}

	.feature-card.blue {
		color: #1f63ff;
	}

	.feature-card h2 {
		margin: 0 0 0.35rem;
		font-size: 1.02rem;
		text-transform: uppercase;
		color: #fff;
	}

	.feature-card p {
		margin: 0;
		font-size: 0.94rem;
		line-height: 1.45;
		color: #d0d8e7;
	}

	.about-section {
		background: #f5f5f5;
		color: #101522;
		padding: 2.8rem 0;
	}

	.about-shell {
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		gap: 1.5rem;
		align-items: start;
	}

	.about-copy {
		padding: 0.6rem 0 0;
	}

	.about-copy .section-title {
		max-width: 8ch;
		margin-bottom: 1.1rem;
		font-size: clamp(3rem, 5vw, 5rem);
		line-height: 0.92;
	}

	.section-underline {
		width: 2.1rem;
		height: 0.22rem;
		margin-bottom: 1.25rem;
		background: #e31d1c;
	}

	.about-gallery {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr 0.85fr;
		grid-template-rows: 12rem 12rem;
		gap: 0.9rem;
	}

	.about-gallery img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.about-gallery .about-main {
		grid-row: span 2;
	}

	.classes-section {
		background: #f5f5f5;
		color: #111827;
		padding: 1rem 0 3.2rem;
	}

	.center {
		text-align: center;
	}

	.center-title {
		text-align: center;
		margin: 0 auto 2rem;
		max-width: none;
		font-size: clamp(2.3rem, 4vw, 3.65rem);
	}

	.class-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
	}

	.class-card {
		background: #fff;
		border: 1px solid rgba(17, 23, 35, 0.08);
		box-shadow: 0 16px 32px rgba(15, 18, 28, 0.08);
		transition: transform 160ms ease, box-shadow 160ms ease;
	}

	.class-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 22px 42px rgba(15, 18, 28, 0.12);
	}

	.pricing-section {
		padding: 0 0 3rem;
		background: #f5f5f5;
		color: #111827;
	}

	.pricing-title {
		margin-bottom: 1.8rem;
	}

	.pricing-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.pricing-card {
		position: relative;
		background: #fff;
		border-radius: 1.6rem;
		padding: 1.4rem 1.25rem 1.25rem;
		border: 2px solid rgba(17, 23, 35, 0.08);
		box-shadow: 0 20px 40px rgba(15, 18, 28, 0.08);
		overflow: hidden;
	}

	.pricing-card.gold {
		border-color: rgba(227, 173, 18, 0.55);
	}

	.pricing-card.blue {
		border-color: rgba(23, 98, 255, 0.5);
	}

	.pricing-card.red {
		border-color: rgba(227, 29, 28, 0.45);
	}

	.pricing-badge {
		position: absolute;
		top: 0.9rem;
		left: 50%;
		transform: translateX(-50%);
		padding: 0.35rem 0.8rem;
		border-radius: 999px;
		background: #1756ef;
		color: #fff;
		font-size: 0.8rem;
		font-weight: 900;
		text-transform: uppercase;
	}

	.pricing-head {
		padding-top: 0.8rem;
		text-align: center;
	}

	.pricing-head h3 {
		margin: 0;
		font-size: 1.2rem;
		text-transform: uppercase;
	}

	.pricing-head p {
		margin: 0.35rem 0 0;
